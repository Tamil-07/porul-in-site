# Astro and Vite build output is regenerated by Cloudflare Pages, so committing
# it would create noise without improving deploy reliability.
dist/
.astro/

# Dependency folders are restored from package-lock.json during each build,
# keeping the repository small and reproducible.
node_modules/

# Local environment files stay out of Git because future CMS/OAuth setup will
# involve machine-specific secrets or callback values.
.env
.env.*
.DS_Store
.firecrawl/
