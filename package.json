{
  "name": "porul-in-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/build-markdown.mjs && npm run check:discovery && npm test",
    "test": "node --test tests/*.test.mjs",
    "check:discovery": "node scripts/check-discovery.mjs",
