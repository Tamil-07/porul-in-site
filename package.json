    "@astrojs/sitemap": "^3.7.3",
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "fast-xml-parser": "5.10.1",
    "parse5": "7.3.0",
    "wrangler": "^4.113.0"
  }
}
