---
interface Props { text?: string; }
const { text } = Astro.props;
---
{text && <aside class="takeaway" aria-labelledby="key-takeaway"><p class="takeaway__label" id="key-takeaway" lang="en">Key takeaway</p><p class="takeaway__text">{text}</p></aside>}
<style>
  .takeaway { margin: var(--space-0) var(--space-0) var(--space-8); padding: var(--panel-padding); border: var(--border-width) solid var(--border-strong); border-radius: var(--radius-panel); background: var(--surface-2); }
  .takeaway__label { margin: var(--space-0) var(--space-0) var(--space-2); color: var(--text-secondary); font-family: var(--font-ui); font-size: var(--type-meta); line-height: var(--leading-meta); }
  .takeaway__text { margin: var(--space-0); font-family: var(--font-reading); font-size: var(--type-reading); font-weight: var(--weight-semibold); line-height: var(--leading-reading); }
</style>
