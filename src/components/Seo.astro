---
import { whatsappUrl } from "@/data/contact";
interface ArticleSeo {
  headline: string;
  publishDate: Date | string;
  updatedDate?: Date | string;
  image?: string;
  inLanguage?: "en" | "ta";
  section?: string;
}

interface BreadcrumbSeo {
  name: string;
  path: string;
}

interface Props {
  title: string;
  description: string;
  lang?: "en" | "ta";
  canonicalPath?: string;
  article?: ArticleSeo;
  breadcrumbs?: BreadcrumbSeo[];
  noindex?: boolean;
  service?: { name: string; description: string; path: string; email: string };
  faqs?: { question: string; answer: string }[];
}

const {
  title,
  description,
  lang = "en",
  canonicalPath,
  article,
  breadcrumbs = [],
  noindex = false,
  service,
  faqs = []
} = Astro.props;

const site = Astro.site ?? new URL("https://porul.in");
const suffix = " — Porul.in";

// Search titles and descriptions are bounded here so future CMS entries cannot
// silently exceed the limits set in the PRD.
const truncate = (value: string, limit: number) => {
  const characters = Array.from(value.trim());
  if (characters.length <= limit) return value.trim();
  const candidate = characters.slice(0, limit - 1).join("");
  const lastSpace = candidate.lastIndexOf(" ");
  return `${candidate.slice(0, lastSpace > limit * 0.65 ? lastSpace : undefined).trim()}…`;
};

const rawTitle = title.trim();
const pageTitle = rawTitle.endsWith(suffix) ? rawTitle.slice(0, -suffix.length) : rawTitle;
const resolvedTitle = rawTitle.startsWith("Porul.in")
  ? truncate(rawTitle, 60)
  : `${truncate(pageTitle, 60 - suffix.length)}${suffix}`;
const resolvedDescription = truncate(description, 155);
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, site).toString();
const defaultImageUrl = new URL("/og-default.png", site).toString();
// Social cards deliberately stay on the single launch placeholder; a real
// article hero can still strengthen Article schema without becoming an OG crop.
const socialImageUrl = defaultImageUrl;
const articleImageUrl = new URL(article?.image ?? "/og-default.png", site).toString();
const organizationId = new URL("/#organization", site).toString();
const websiteId = new URL("/#website", site).toString();

const graph: Record<string, unknown>[] = [
  {
    "@type": "Organization",
    "@id": organizationId,
    name: "Porul.in",
    url: site.toString(),
    email: "hello@porul.in",
    // A WhatsApp contact is not a promise of voice-call availability.
    contactPoint: {
      "@type": "ContactPoint",
      contactType: "Business enquiries via WhatsApp or email",
      url: whatsappUrl(),
      email: "hello@porul.in"
    },
    description: "An extended back office for Tamil Nadu MSMEs, with GeM registration and catalogue support available.",
    sameAs: ["https://www.linkedin.com/company/porul-in/"]
  },
  {
    "@type": "WebSite",
    "@id": websiteId,
    name: "Porul.in",
    url: site.toString(),
    description: "MSME back-office support, company stories and sector intelligence.",
    publisher: { "@id": organizationId },
    inLanguage: ["en", "ta"]
  },
  {
    "@type": "WebPage",
    "@id": canonicalUrl,
    url: canonicalUrl,
    name: resolvedTitle,
    description: resolvedDescription,
    inLanguage: lang,
    isPartOf: { "@id": websiteId },
    publisher: { "@id": organizationId },
    ...(breadcrumbs.length ? { breadcrumb: { "@id": `${canonicalUrl}#breadcrumbs` } } : {})
  }
];

// Service and FAQ entities describe visible content, without implying a local
// office, government affiliation, reviews or a price that has not been agreed.
if (service) {
  graph.push({
    "@type": "Service",
    "@id": `${canonicalUrl}#service`,
    name: service.name,
    description: service.description,
    url: new URL(service.path, site).toString(),
    serviceType: "GeM seller registration and product catalogue assistance",
    provider: { "@id": organizationId },
    areaServed: { "@type": "State", name: "Tamil Nadu", containedInPlace: { "@type": "Country", name: "India" } },
    availableChannel: { "@type": "ServiceChannel", serviceUrl: new URL("/enquire/", site).toString() }
  });
}

if (faqs.length) {
  graph.push({
    "@type": "FAQPage",
    "@id": `${canonicalUrl}#faq`,
    mainEntity: faqs.map(({ question, answer }) => ({
      "@type": "Question", name: question,
      acceptedAnswer: { "@type": "Answer", text: answer }
    }))
  });
}

if (article) {
  graph.push({
    "@type": "Article",
    "@id": `${canonicalUrl}#article`,
    mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
    headline: article.headline,
    description: resolvedDescription,
    image: [articleImageUrl],
    datePublished: new Date(article.publishDate).toISOString(),
    dateModified: new Date(article.updatedDate ?? article.publishDate).toISOString(),
    author: { "@id": organizationId },
    publisher: { "@id": organizationId },
    inLanguage: article.inLanguage ?? lang,
    articleSection: article.section
  });
}

if (breadcrumbs.length > 0) {
  graph.push({
    "@type": "BreadcrumbList",
    "@id": `${canonicalUrl}#breadcrumbs`,
    itemListElement: breadcrumbs.map((crumb, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: crumb.name,
      item: new URL(crumb.path, site).toString()
    }))
  });
}

// Escaping '<' keeps CMS-authored text from terminating the JSON-LD script.
const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(/</g, "\\u003c");
---

<title>{resolvedTitle}</title>
<meta name="description" content={resolvedDescription} />
<link rel="canonical" href={canonicalUrl} />
<link rel="sitemap" type="application/xml" href={new URL("/sitemap-index.xml", site)} />
<link rel="alternate" type="application/rss+xml" title="Porul.in RSS" href={new URL("/rss.xml", site)} />
<meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />

<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:site_name" content="Porul.in" />
<meta property="og:locale" content={lang === "ta" ? "ta_IN" : "en_IN"} />
<meta property="og:title" content={resolvedTitle} />
<meta property="og:description" content={resolvedDescription} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={socialImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Porul.in — An extended back office for Tamil Nadu MSMEs" />
{article && <meta property="article:published_time" content={new Date(article.publishDate).toISOString()} />}
{article && <meta property="article:modified_time" content={new Date(article.updatedDate ?? article.publishDate).toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={resolvedTitle} />
<meta name="twitter:description" content={resolvedDescription} />
<meta name="twitter:image" content={socialImageUrl} />
<meta name="twitter:image:alt" content="Porul.in — An extended back office for Tamil Nadu MSMEs" />

<script type="application/ld+json" set:html={jsonLd} />
