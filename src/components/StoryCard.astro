---
import CommercialDisclosure from "@/components/CommercialDisclosure.astro";
interface Props {
  title: string; dek: string; location: string; readingMinutes: number; publishDate?: Date; updatedDate?: Date; slug: string;
  sponsored?: boolean; sponsorName?: string; sponsorInvolvement?: string; authorship?: "porul" | "partner"; producerName?: string;
  heroImage?: string; heroImageAlt?: string;
  headingLevel?: 2 | 3;
  featured?: boolean; heroImageCaption?: string; heroImageWidth?: number; heroImageHeight?: number;
}
const { title, dek, location, readingMinutes, publishDate, updatedDate, slug, heroImage, heroImageAlt = "" } = Astro.props;
const { featured = false, heroImageCaption, heroImageWidth, heroImageHeight } = Astro.props;
const date = updatedDate ?? publishDate;
const Heading = Astro.props.headingLevel === 2 ? "h2" : "h3";
const dateLabel = date ? new Intl.DateTimeFormat("en-IN", { day: "numeric", month: "short", year: "numeric" }).format(date) : undefined;
---
<article class:list={["story-card", {"story-card--featured": featured}]}>
  {heroImage && !featured && <a class="story-card__media" href={`/stories/${slug}/`} tabindex="-1" aria-hidden="true"><img src={heroImage} alt={heroImageAlt} loading="lazy" /></a>}
  <div class="story-card__body">
    <CommercialDisclosure {...Astro.props} compact />
    <p class="story-card__meta">Company story · {location} · {readingMinutes} min{dateLabel && <> · {updatedDate ? "Updated " : ""}<time datetime={date?.toISOString()}>{dateLabel}</time></>}</p>
    <Heading><a href={`/stories/${slug}/`}>{title}</a></Heading>
    <p class="story-card__dek">{dek}</p>
    {featured && <p class="story-card__meta">{Astro.props.authorship === "partner" ? Astro.props.producerName : "Porul.in / Editorial"}</p>}
    {heroImage && featured && <figure class="story-card__figure"><img src={heroImage} alt={heroImageAlt} width={heroImageWidth} height={heroImageHeight} loading="lazy" />{heroImageCaption && <figcaption>{heroImageCaption}</figcaption>}</figure>}
    <a class="story-card__read" href={`/stories/${slug}/`} aria-label={`Read the story: ${title}`}>Read the story <span aria-hidden="true">→</span></a>
  </div>
</article>
<style>
  .story-card { display: flex; flex-direction: column; min-width: var(--width-zero); border-top: var(--border-width) solid var(--border-strong); }
  .story-card__media { display: block; aspect-ratio: var(--image-story-ratio); overflow: hidden; }
  img { display: block; width: var(--width-full); height: var(--width-full); object-fit: cover; }
  .story-card__body { display: flex; flex: 1; flex-direction: column; align-items: start; gap: var(--space-4); padding: var(--space-6) var(--space-0); }
  .story-card__meta { margin: var(--space-0); color: var(--text-secondary); font-family: var(--font-ui); font-size: var(--type-meta); line-height: var(--leading-meta); }
  h2, h3 { margin: var(--space-0); font-family: var(--font-reading); font-size: var(--type-card); font-weight: var(--weight-semibold); line-height: var(--leading-card); }
  :is(h2, h3) a { color: var(--text-primary); text-decoration: none; }
  :is(h2, h3) a:hover { color: var(--accent); text-decoration: underline; }
  .story-card__dek { margin: var(--space-0); color: var(--text-secondary); font-size: var(--type-body); line-height: var(--leading-body); }
  .story-card__read { display: inline-flex; align-items: center; gap: var(--space-2); min-height: var(--control-height); margin-top: auto; font-family: var(--font-ui); font-size: var(--type-control); font-weight: var(--weight-semibold); line-height: var(--leading-control); }
  .story-card--featured { border-top: none; }
  .story-card--featured :is(h2,h3) { font-size: var(--type-section); line-height: var(--leading-section); }
  .story-card--featured .story-card__dek { font-family: var(--font-reading); font-size: var(--type-reading); line-height: var(--leading-reading); color: var(--text-primary); }
  .story-card__figure { margin: var(--space-0); width: var(--width-full); }
  .story-card__figure img { height: auto; aspect-ratio: var(--image-story-ratio); object-fit: contain; }
  figcaption { margin-top: var(--space-2); font-size: var(--type-meta); line-height: var(--leading-meta); color: var(--text-secondary); }
</style>
