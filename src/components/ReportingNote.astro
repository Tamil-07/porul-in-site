---
interface Props { reportingNote: string; verificationNote?: string; sponsored?: boolean; authorship?: "porul" | "partner"; }
const { reportingNote, verificationNote, sponsored = false, authorship = "porul" } = Astro.props;
---
<aside class="reporting-note" aria-labelledby="reporting-note-title" lang="en">
  <p class="fine">Reporting record</p><h2 id="reporting-note-title">How this story was reported</h2>
  <dl><div><dt>Source basis</dt><dd>{reportingNote}</dd></div>{verificationNote && <div><dt>Verification</dt><dd>{verificationNote}</dd></div>}<div><dt>Commercial status</dt><dd>{sponsored ? "Sponsored; funding is disclosed above." : authorship === "partner" ? "Partner-supplied content; producer is disclosed above. Not sponsored." : "Independent editorial; not sponsored."}</dd></div></dl>
</aside>
<style>
  .reporting-note { margin-bottom: var(--space-8); padding: var(--panel-padding); border: var(--border-width) solid var(--border); border-radius: var(--radius-panel); background: var(--surface-2); font-family: var(--font-ui); }
  h2 { margin: var(--space-2) var(--space-0) var(--space-5); font-size: var(--type-card); font-weight: var(--weight-semibold); line-height: var(--leading-card); }
  dl { display: grid; gap: var(--space-4); margin: var(--space-0); }
  dl div { display: grid; gap: var(--space-2); }
  dt, dd { margin: var(--space-0); font-size: var(--type-body); line-height: var(--leading-body); }
  dt { color: var(--text-secondary); font-weight: var(--weight-semibold); }
</style>
