---
interface Props { author?: "Porul.in"; authorRole?: "Editorial"; publishDate: Date; updatedDate?: Date; lang?: "en" | "ta"; producerName?: string; }
const { author = "Porul.in", authorRole = "Editorial", publishDate, updatedDate, lang = "en", producerName } = Astro.props;
const formatDate = (date: Date) => new Intl.DateTimeFormat(lang === "ta" ? "ta-IN" : "en-IN", { day: "numeric", month: "long", year: "numeric" }).format(date);
---
<div class="editorial-meta" aria-label="Article details">
  <p class="editorial-meta__byline" lang="en"><strong>{producerName ?? author}</strong><span>{producerName ? "Partner producer" : authorRole}</span></p>
  <dl>
    <div><dt lang="en">Published</dt><dd><time datetime={publishDate.toISOString()}>{formatDate(publishDate)}</time></dd></div>
    {updatedDate && <div><dt lang="en">Updated</dt><dd><time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></dd></div>}
  </dl>
</div>
<style>
  .editorial-meta { display: flex; flex-wrap: wrap; align-items: start; justify-content: space-between; gap: var(--space-4) var(--space-8); padding-top: var(--space-5); border-top: var(--border-width) solid var(--border); font-family: var(--font-ui); font-size: var(--type-meta); line-height: var(--leading-meta); }
  .editorial-meta__byline { display: grid; gap: var(--space-1); margin: var(--space-0); }
  strong { font-weight: var(--weight-semibold); }
  span, dt { color: var(--text-secondary); }
  dl { display: flex; flex-wrap: wrap; gap: var(--space-4) var(--space-8); margin: var(--space-0); }
  dl div { display: grid; gap: var(--space-1); }
  dt, dd { margin: var(--space-0); }
</style>
