---
interface Props { sources?: { label: string; url: string }[]; }
const { sources = [] } = Astro.props;
---
{sources.length > 0 && <section class="sources" aria-labelledby="article-sources" lang="en"><p class="fine">Evidence</p><h2 id="article-sources">Sources</h2><ol>{sources.map(source => <li><a href={source.url}>{source.label}</a></li>)}</ol></section>}
<style>
  .sources { margin: var(--space-12) var(--space-0) var(--space-8); padding-top: var(--space-6); border-top: var(--border-width) solid var(--border-strong); }
  h2 { margin: var(--space-2) var(--space-0) var(--space-4); font-family: var(--font-ui); font-size: var(--type-section); font-weight: var(--weight-semibold); line-height: var(--leading-section); }
  ol { display: grid; gap: var(--space-3); margin: var(--space-0); padding-left: var(--space-6); font-family: var(--font-ui); font-size: var(--type-body); line-height: var(--leading-body); }
  a { overflow-wrap: anywhere; text-decoration: underline; text-underline-offset: var(--underline-offset); }
</style>
