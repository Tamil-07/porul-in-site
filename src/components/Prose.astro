---
interface Props {
  variant?: "latin" | "tamil";
}

const { variant = "latin" } = Astro.props;
---

<div class:list={["prose", variant === "tamil" && "prose--tamil"]}>
  <slot />
</div>

<style>
  .prose {
    max-width: 68ch;
    color: #2D2D33;
    font-size: 18px;
    line-height: 1.82;
  }

  .prose--tamil {
    max-width: 66ch;
    font-family: var(--tamil);
    font-size: 17px;
    line-height: 1.9;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(blockquote) {
    margin: 0 0 1.35em;
  }

  .prose :global(h2),
  .prose :global(h3) {
    margin: 1.8em 0 0.55em;
    color: var(--ink);
    font-family: var(--display);
    line-height: 1.08;
  }

  .prose--tamil :global(h2),
  .prose--tamil :global(h3) {
    font-family: var(--tamil);
    line-height: 1.28;
  }

  .prose :global(a) {
    color: var(--spark);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.22em;
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--spark);
    padding-left: 20px;
    color: #4A4A52;
  }

  .prose :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
  }
</style>
