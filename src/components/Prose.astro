---
interface Props { variant?: "latin" | "tamil"; }
const { variant = "latin" } = Astro.props;
---
<div class="prose" lang={variant === "tamil" ? "ta" : undefined}><slot /></div>
<style>
  .prose { color: var(--text-primary); font-family: var(--font-reading); font-size: var(--type-reading); font-weight: var(--weight-regular); line-height: var(--leading-reading); overflow-wrap: anywhere; }
  .prose :global(.service-page) { font-family: var(--font-reading); font-size: var(--type-reading); line-height: var(--leading-reading); }
  .prose :global(.service-page p) { color: var(--text-primary); }
  .prose :global(.intro-copy) { font-size: var(--type-reading); line-height: var(--leading-reading); }
  .prose :global(.fine), .prose :global(.breadcrumbs), .prose :global(.eyebrow) { font-family: var(--font-ui); }
  .prose :global(.service-split), .prose :global(.guide-grid) { grid-template-columns: var(--grid-one); }
  .prose :global(p), .prose :global(ul), .prose :global(ol), .prose :global(blockquote), .prose :global(figure) { margin: var(--space-0) var(--space-0) var(--paragraph-gap); }
  .prose :global(h2), .prose :global(h3), .prose :global(h4) { margin: var(--group-gap) var(--space-0) var(--space-4); color: var(--text-primary); font-family: var(--font-ui); font-weight: var(--weight-semibold); text-wrap: balance; }
  .prose :global(h2) { font-size: var(--type-section); line-height: var(--leading-section); }
  .prose :global(h3), .prose :global(h4) { font-size: var(--type-card); line-height: var(--leading-card); }
  .prose :global(ul), .prose :global(ol) { padding-left: var(--space-6); }
  .prose :global(li + li) { margin-top: var(--space-2); }
  .prose :global(strong) { font-weight: var(--weight-semibold); }
  .prose :global(em) { font-style: normal; }
  .prose :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: var(--underline-offset); }
  .prose :global(a:hover) { color: var(--accent-hover); }
  .prose :global(blockquote) { border-left: var(--border-width-active) solid var(--border-strong); padding-left: var(--space-5); color: var(--text-secondary); }
  .prose :global(img) { display: block; max-width: var(--width-full); height: auto; }
  .prose :global(hr) { margin: var(--group-gap) var(--space-0); border: none; border-top: var(--border-width) solid var(--border); }
  .prose :global(table) { display: block; width: var(--width-full); overflow-x: auto; border-collapse: collapse; font-family: var(--font-ui); font-size: var(--type-body); line-height: var(--leading-body); }
  .prose :global(th), .prose :global(td) { padding: var(--space-3); text-align: left; border-bottom: var(--border-width) solid var(--border); }
</style>
