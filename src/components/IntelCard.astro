---
import CommercialDisclosure from "@/components/CommercialDisclosure.astro";
interface Props {
  title: string; dek: string; category: string; readingMinutes: number; publishDate?: Date; updatedDate?: Date; slug: string;
  sponsored?: boolean; sponsorName?: string; sponsorInvolvement?: string; authorship?: "porul" | "partner"; producerName?: string;
  basePath?: string; readLabel?: string;
  headingLevel?: 2 | 3;
}
const { title, dek, category, readingMinutes, publishDate, updatedDate, slug, basePath = "/intelligence", readLabel = "Read the analysis" } = Astro.props;
const date = updatedDate ?? publishDate;
const Heading = Astro.props.headingLevel === 2 ? "h2" : "h3";
const dateLabel = date ? new Intl.DateTimeFormat(basePath === "/ta" ? "ta-IN" : "en-IN", { day: "numeric", month: "short", year: "numeric" }).format(date) : undefined;
---
<article class="intel-card">
  <CommercialDisclosure {...Astro.props} compact />
  <p class="intel-card__meta">{category} · {readingMinutes} min{dateLabel && <> · {updatedDate ? "Updated " : ""}<time datetime={date?.toISOString()}>{dateLabel}</time></>}</p>
  <Heading><a href={`${basePath}/${slug}/`}>{title}</a></Heading>
  <p class="intel-card__dek">{dek}</p>
  <a class="intel-card__read" href={`${basePath}/${slug}/`} aria-label={`${readLabel}: ${title}`}>{readLabel} <span aria-hidden="true">→</span></a>
</article>
<style>
  .intel-card { display: flex; flex-direction: column; align-items: start; gap: var(--space-4); min-width: var(--width-zero); padding: var(--space-6) var(--space-0); border-top: var(--border-width) solid var(--border-strong); }
  .intel-card__meta { margin: var(--space-0); color: var(--text-secondary); font-family: var(--font-ui); font-size: var(--type-meta); line-height: var(--leading-meta); }
  h2, h3 { margin: var(--space-0); font-family: var(--font-reading); font-size: var(--type-card); font-weight: var(--weight-semibold); line-height: var(--leading-card); }
  :is(h2, h3) a { color: var(--text-primary); text-decoration: none; }
  :is(h2, h3) a:hover { color: var(--accent); text-decoration: underline; }
  .intel-card__dek { margin: var(--space-0); color: var(--text-secondary); font-size: var(--type-body); line-height: var(--leading-body); }
  .intel-card__read { display: inline-flex; align-items: center; gap: var(--space-2); min-height: var(--control-height); margin-top: auto; font-family: var(--font-ui); font-size: var(--type-control); font-weight: var(--weight-semibold); line-height: var(--leading-control); }
</style>
