---
import EditorialMeta from "@/components/EditorialMeta.astro";
import CommercialDisclosure from "@/components/CommercialDisclosure.astro";
interface Props {
  kicker: string; title: string; dek: string; sponsored?: boolean;
  sponsorName?: string; sponsorInvolvement?: string; authorship?: "porul" | "partner"; producerName?: string;
  author?: "Porul.in"; authorRole?: "Editorial"; publishDate: Date; updatedDate?: Date; lang?: "en" | "ta";
}
const { kicker, title, dek, author = "Porul.in", authorRole = "Editorial", publishDate, updatedDate, lang = "en", authorship = "porul", producerName } = Astro.props;
---
<header class="article-head">
  <p class="article-head__kicker">{kicker}</p>
  <CommercialDisclosure {...Astro.props} />
  <h1>{title}</h1>
  <p class="article-head__dek">{dek}</p>
  <EditorialMeta author={author} authorRole={authorRole} publishDate={publishDate} updatedDate={updatedDate} lang={lang} producerName={authorship === "partner" ? producerName : undefined} />
</header>
<style>
  .article-head { display: grid; gap: var(--space-6); padding: var(--section-gap) var(--space-0) var(--space-8); }
  .article-head__kicker { margin: var(--space-0); color: var(--text-secondary); font-family: var(--font-ui); font-size: var(--type-meta); line-height: var(--leading-meta); }
  h1 { margin: var(--space-0); font-family: var(--font-reading); font-size: var(--type-title); font-weight: var(--weight-semibold); line-height: var(--leading-title); letter-spacing: var(--tracking-display); text-wrap: balance; }
  .article-head__dek { margin: var(--space-0); color: var(--text-secondary); font-family: var(--font-reading); font-size: var(--type-reading); line-height: var(--leading-reading); }
</style>
