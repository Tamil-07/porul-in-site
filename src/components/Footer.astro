---
import { whatsappUrl } from '@/data/contact';
const year = new Date().getFullYear();
const linkGroups = [
  {
    heading: 'Services',
    links: [
      { label: 'GeM support', href: '/gem-services/' },
      { label: 'Digital signature support', href: '/digital-signature-for-gem/' },
      { label: 'Websites & software', href: '/enquire/?service=website-software' },
      { label: 'Business stories', href: '/enquire/?service=story' },
      { label: 'Government schemes', href: '/msme-benefits/' }
    ]
  },
  {
    heading: 'Read',
    links: [
      { label: 'Stories', href: '/stories/' },
      { label: 'Share your story', href: '/share-your-story/' },
      { label: 'Intelligence', href: '/intelligence/' },
      { label: 'Guides', href: '/guides/' },
      { label: 'The Room', href: '/the-room/' }
    ]
  },
  {
    heading: 'Porul',
    links: [
      { label: 'About', href: '/about/' },
      { label: 'Contact', href: '/contact/' },
      { label: 'Enquire', href: '/enquire/' },
      { label: 'Tamil', href: '/ta/' }
    ]
  },
  {
    heading: 'More',
    links: [
      { label: 'Privacy', href: '/privacy/' },
      { label: 'Sponsor', href: '/sponsor/' },
      { label: 'RSS', href: '/rss.xml' },
      { label: 'Sitemap', href: '/sitemap-index.xml' }
    ]
  }
];
---

<footer class='footer'>
  <div class='wrap footer__wrap'>
    <div class='footer__grid'>
      <div class='footer__brand'>
        <a class='footer__wordmark' href='/' aria-label='Porul.in home'><span>Porul<span class='footer__wordmark-dot'>.</span>in</span> <span class='footer__tamil' lang='ta'>பொருள்</span></a>
        <p class='footer__description'>Business support for small manufacturers. Stories and insight from the people who make things.</p>
        <p class='footer__location'>
          <svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z'/><circle cx='12' cy='10' r='2.5'/></svg>
          <span>Coimbatore, Tamilnadu</span>
        </p>
        <p class='footer__note'>Independent of GeM and government bodies.</p>
      </div>
      <nav class='footer__nav' aria-label='Footer'>
        {linkGroups.map(function (group) {
          return (
            <div class='footer__group'>
              <h2 class='footer__heading'>{group.heading}</h2>
              <ul class='footer__link-list'>
                {group.links.map(function (link) {
                  return (
                    <li><a class='footer__link' href={link.href}>{link.label}</a></li>
                  );
                })}
              </ul>
            </div>
          );
        })}
      </nav>
    </div>
    <div class='footer__contact-row'>
      <div class='footer__contact-intro'>
        <p class='footer__contact-label'>Let’s talk about your business.</p>
        <a class='footer__email' href='mailto:hello@porul.in'>hello@porul.in</a>
      </div>
      <div class='footer__contact-actions'>
        <a class='button footer__whatsapp' href={whatsappUrl()} aria-label='Chat with Porul on WhatsApp'>
          <svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M20.5 11.5a8.5 8.5 0 0 1-12.7 7.4L3 20.5l1.6-4.8a8.5 8.5 0 1 1 15.9-4.2Z'/><path d='M8.5 7.5c-.8.5-1.1 1.5-.5 2.7 1.2 2.4 2.7 3.9 5.1 5.1 1.2.6 2.2.3 2.7-.5l.7-1.1-2.8-1.4-.8.8a8.5 8.5 0 0 1-3-3l.8-.8-1.4-2.8-.8 1Z'/></svg>
          <span>Chat on WhatsApp</span>
        </a>
        <a class='footer__social' href='https://www.linkedin.com/company/porul-in/' target='_blank' rel='noopener noreferrer'>LinkedIn</a>
      </div>
    </div>
    <div class='footer__bottom'>
      <p class='footer__legal'>&copy; {year} Porul.in</p>
      <p class='footer__credit'><span>Designed &amp; Developed by</span> <a href='https://enmiya.com/' target='_blank' rel='noopener noreferrer'>Enmiya</a></p>
    </div>
  </div>
</footer>

<style>
.footer {
  background-color: var(--surface-2);
  border-top: var(--border-width) solid var(--border);
  font-family: var(--font-ui);
  font-size: var(--type-control);
  font-weight: var(--weight-regular);
  line-height: var(--leading-control);
  letter-spacing: var(--tracking-normal);
}

.footer__wrap {
  display: grid;
  gap: var(--space-0);
  padding-block: var(--footer-padding) var(--space-6);
}

.footer__grid {
  display: grid;
  gap: var(--space-10) var(--space-12);
  grid-template-columns: var(--footer-columns);
  align-items: start;
  padding-bottom: var(--footer-padding);
}

.footer__brand {
  display: grid;
  align-content: start;
  gap: var(--item-gap);
  min-width: var(--width-zero);
}

.footer__wordmark {
  display: inline-flex;
  align-items: baseline;
  gap: var(--label-gap);
  font-family: var(--font-brand);
  font-size: var(--type-wordmark);
  line-height: var(--leading-control);
  font-weight: var(--weight-brand);
  letter-spacing: var(--tracking-normal);
  color: var(--text-primary);
  text-decoration-line: none;
}

.footer__wordmark-dot {
  color: var(--accent);
}

.footer__tamil {
  font-family: var(--font-tamil-ui);
  font-size: var(--type-control);
  line-height: var(--leading-control);
  font-weight: var(--weight-regular);
}

.footer__description {
  margin: var(--space-0);
  font-family: var(--font-ui);
  font-size: var(--type-control);
  line-height: var(--leading-control);
  font-weight: var(--weight-regular);
  letter-spacing: var(--tracking-normal);
  color: var(--text-secondary);
}

.footer__note {
  margin: var(--space-0);
  font-size: var(--type-meta);
  line-height: var(--leading-meta);
  color: var(--text-tertiary);
}

.footer__location {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin: var(--space-2) var(--space-0) var(--space-0);
  color: var(--text-primary);
}

.footer__location svg {
  width: var(--space-4);
  height: var(--space-4);
  flex-shrink: 0;
  color: var(--accent);
}

.footer__nav {
  display: grid;
  gap: var(--space-8) var(--space-6);
  grid-template-columns: var(--footer-nav-columns);
}

.footer__group {
  display: grid;
  align-content: start;
  gap: var(--label-gap);
}

.footer__heading {
  margin: var(--space-0);
  font-family: var(--font-ui);
  font-size: var(--type-control);
  line-height: var(--leading-control);
  font-weight: var(--weight-semibold);
  letter-spacing: var(--tracking-normal);
  color: var(--text-primary);
}

.footer__link-list {
  list-style: none;
  margin: var(--space-0);
  padding: var(--space-0);
  display: grid;
  gap: var(--space-0);
}

.footer__link {
  display: inline-flex;
  align-items: center;
  min-height: var(--control-height);
  font-family: var(--font-ui);
  font-size: var(--type-control);
  line-height: var(--leading-control);
  font-weight: var(--weight-regular);
  letter-spacing: var(--tracking-normal);
  text-decoration-line: none;
  color: var(--text-secondary);
}

.footer__link:hover {
  color: var(--accent);
  text-decoration-line: underline;
  text-decoration-thickness: var(--border-width);
  text-underline-offset: var(--underline-offset);
}

.footer__contact-row {
  display: flex;
  flex-direction: var(--footer-row-direction);
  align-items: var(--footer-row-align);
  justify-content: space-between;
  gap: var(--space-6);
  padding-block: var(--space-6);
  border-top: var(--border-width) solid var(--border-strong);
}

.footer__contact-label {
  margin: var(--space-0);
  font-size: var(--type-meta);
  line-height: var(--leading-meta);
  color: var(--text-secondary);
}

.footer__email {
  display: inline-flex;
  align-items: center;
  min-height: var(--control-height);
  font-size: var(--type-control);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  text-decoration: none;
}

.footer__contact-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-4) var(--space-6);
}

.footer__whatsapp svg {
  width: var(--space-5);
  height: var(--space-5);
  flex-shrink: 0;
}

.footer__social {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  min-height: var(--control-height);
  color: var(--text-secondary);
  text-decoration: none;
}

.footer__bottom {
  display: flex;
  flex-direction: var(--footer-row-direction);
  align-items: var(--footer-row-align);
  justify-content: space-between;
  gap: var(--space-3) var(--space-6);
  padding-top: var(--space-4);
  border-top: var(--border-width) solid var(--border);
}

/* The complete credit uses one explicit UI role so the label cannot inherit
   a larger body size than its backlink. Keep it separate from contact actions. */
.footer__legal,
.footer__credit {
  margin: var(--space-0);
  font-family: var(--font-ui);
  font-size: var(--type-meta);
  line-height: var(--leading-meta);
  font-weight: var(--weight-regular);
  letter-spacing: var(--tracking-normal);
  color: var(--text-tertiary);
}

.footer__credit {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: var(--space-1);
}

.footer__credit a {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  padding-block: var(--space-3);
  font: inherit;
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  text-decoration: underline;
  text-decoration-color: var(--border-strong);
  text-underline-offset: var(--underline-offset);
}

.footer__credit a:hover,
.footer__email:hover,
.footer__social:hover {
  color: var(--accent);
  text-decoration: underline;
}
</style>
