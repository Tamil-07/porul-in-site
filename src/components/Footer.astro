---
import { whatsappDisplay, whatsappUrl } from '@/data/contact';
const year = new Date().getFullYear();
const linkGroups = [
  {
    heading: 'Services',
    links: [
      { label: 'GeM support', href: '/gem-services/' },
      { label: 'Digital signature support', href: '/digital-signature-for-gem/' },
      { label: 'Websites & software', href: '/enquire/?service=website-software' },
      { label: 'Business stories', href: '/enquire/?service=story' },
      { label: 'Government schemes', href: '/msme-benefits/' }
    ]
  },
  {
    heading: 'Read',
    links: [
      { label: 'Stories', href: '/stories/' },
      { label: 'Intelligence', href: '/intelligence/' },
      { label: 'Guides', href: '/guides/' },
      { label: 'The Room', href: '/the-room/' }
    ]
  },
  {
    heading: 'Porul',
    links: [
      { label: 'About', href: '/about/' },
      { label: 'Contact', href: '/contact/' },
      { label: 'Enquire', href: '/enquire/' },
      { label: 'Tamil', href: '/ta/' }
    ]
  },
  {
    heading: 'More',
    links: [
      { label: 'Privacy', href: '/privacy/' },
      { label: 'Sponsor', href: '/sponsor/' },
      { label: 'RSS', href: '/rss.xml' },
      { label: 'Sitemap', href: '/sitemap-index.xml' }
    ]
  }
];
---

<footer class='footer'>
  <div class='wrap footer__wrap'>
    <div class='footer__grid'>
      <div class='footer__brand'>
        <a class='footer__wordmark' href='/' aria-label='Porul.in home'><span>Porul<span class='footer__wordmark-dot'>.</span>in</span> <span class='footer__tamil' lang='ta'>பொருள்</span></a>
        <p class='footer__description'>Practical help for small manufacturers. Talk to us about GeM, a website or software, a business story, or government schemes. Our stories and industry analysis are free to read.</p>
        <p class='footer__note'>Porul is an independent service provider, separate from GeM and the government.</p>
      </div>
      <nav class='footer__nav' aria-label='Footer'>
        {linkGroups.map(function (group) {
          return (
            <div class='footer__group'>
              <h2 class='footer__heading'>{group.heading}</h2>
              <ul class='footer__link-list'>
                {group.links.map(function (link) {
                  return (
                    <li><a class='footer__link' href={link.href}>{link.label}</a></li>
                  );
                })}
              </ul>
            </div>
          );
        })}
      </nav>
      <div class='footer__meta'>
        <ul class='footer__meta-list'>
          <li><a class='footer__link' href='mailto:hello@porul.in'>hello@porul.in</a></li>
          <li><a class='footer__link' href={whatsappUrl()}>WhatsApp: {whatsappDisplay}</a></li>
          <li><a class='footer__link' href='https://www.linkedin.com/company/porul-in/' target='_blank' rel='noopener noreferrer'>LinkedIn</a></li>
          <li>Designed &amp; Developed by <a class='footer__link' href='https://enmiya.com/' target='_blank' rel='noopener noreferrer'>Enmiya</a></li>
          <li><a class='footer__quiet-link' href='https://www.google.com/preferences/source?q=porul.in'>Preferred source: Porul.in on Google</a></li>
        </ul>
      </div>
      <p class='footer__legal'>&copy; {year} Porul.in</p>
    </div>
  </div>
</footer>

<style>
.footer {
  background-color: var(--surface-2);
  border-top: var(--border-width) solid var(--border);
}

.footer__wrap {
  display: grid;
  gap: var(--group-gap);
  padding-block: var(--section-gap);
}

.footer__grid {
  display: grid;
  gap: var(--grid-gap);
  grid-template-columns: var(--grid-pair);
}

.footer__brand {
  display: grid;
  align-content: start;
  gap: var(--item-gap);
}

.footer__wordmark {
  display: inline-flex;
  align-items: baseline;
  gap: var(--label-gap);
  font-family: var(--font-brand);
  font-size: var(--type-wordmark);
  line-height: var(--leading-control);
  font-weight: var(--weight-brand);
  letter-spacing: var(--tracking-normal);
  color: var(--text-primary);
  text-decoration-line: none;
}

.footer__wordmark-dot {
  color: var(--accent);
}

.footer__tamil {
  font-family: var(--font-tamil-ui);
  font-size: var(--type-control);
  line-height: var(--leading-control);
  font-weight: var(--weight-regular);
}

.footer__description,
.footer__note {
  margin: var(--space-0);
  font-family: var(--font-ui);
  font-size: var(--type-control);
  line-height: var(--leading-control);
  font-weight: var(--weight-regular);
  letter-spacing: var(--tracking-normal);
  color: var(--text-secondary);
}

.footer__nav {
  display: grid;
  gap: var(--grid-gap);
  grid-template-columns: var(--grid-pair);
}

.footer__group {
  display: grid;
  align-content: start;
  gap: var(--label-gap);
}

.footer__heading {
  margin: var(--space-0);
  font-family: var(--font-ui);
  font-size: var(--type-control);
  line-height: var(--leading-control);
  font-weight: var(--weight-semibold);
  letter-spacing: var(--tracking-normal);
  color: var(--text-primary);
}

.footer__link-list,
.footer__meta-list {
  list-style: none;
  margin: var(--space-0);
  padding: var(--space-0);
}

.footer__link-list {
  display: grid;
  gap: var(--label-gap);
}

.footer__meta-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--item-gap);
}

.footer__link,
.footer__quiet-link {
  display: inline-flex;
  align-items: center;
  min-height: var(--control-height);
  font-family: var(--font-ui);
  font-size: var(--type-control);
  line-height: var(--leading-control);
  font-weight: var(--weight-regular);
  letter-spacing: var(--tracking-normal);
  text-decoration-line: none;
}

.footer__link {
  color: var(--text-secondary);
}

.footer__link:hover {
  color: var(--accent);
  text-decoration-line: underline;
  text-decoration-thickness: var(--border-width);
  text-underline-offset: var(--underline-offset);
}

.footer__quiet-link {
  color: var(--text-tertiary);
}

.footer__quiet-link:hover {
  color: var(--accent);
  text-decoration-line: underline;
  text-decoration-thickness: var(--border-width);
  text-underline-offset: var(--underline-offset);
}

.footer__meta {
  grid-column: 1 / -1;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--item-gap);
}

.footer__legal {
  grid-column: 1 / -1;
  margin: var(--space-0);
  font-family: var(--font-ui);
  font-size: var(--type-control);
  line-height: var(--leading-control);
  font-weight: var(--weight-regular);
  letter-spacing: var(--tracking-normal);
  color: var(--text-secondary);
}
</style>
