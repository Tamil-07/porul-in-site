---
interface Props {
  kicker: string;
  title: string;
  href: string;
  linkLabel: string;
  headingId?: string;
}

const { kicker, title, href, linkLabel, headingId } = Astro.props;
---

<div class="section-head">
  <div>
    <p class="section-head__kicker">{kicker}</p>
    <h2 id={headingId}>{title}</h2>
  </div>
  <a class="section-head__more" href={href}>{linkLabel} <span aria-hidden="true">→</span></a>
</div>

<style>
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 36px;
    flex-wrap: wrap;
  }

  .section-head__kicker {
    display: block;
    margin: 0 0 12px;
    color: var(--spark);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(28px, 3.6vw, 44px);
    font-weight: 700;
    line-height: 1.08;
  }

  .section-head__more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 700;
  }

  .section-head__more span {
    transition: transform 0.2s ease;
  }

  .section-head__more:hover span {
    transform: translateX(4px);
  }
</style>
