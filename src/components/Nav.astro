---
// Native header menus stay in document flow and retain visible Tamil access.
const normalizePath = (value: string) => value.split("?")[0].replace(/\/+$/, "") || "/";
const currentPath = normalizePath(Astro.props.currentPath || Astro.url.pathname);
const currentService = Astro.props.currentSearch || Astro.url.searchParams.get("service");
const isActivePath = (href: string) => {
  const expected = normalizePath(href);
  return currentPath === expected || (expected !== "/" && currentPath.startsWith(`${expected}/`));
};
const serviceLinks = [
  { href: "/gem-services/", label: "GeM support" },
  { href: "/digital-signature-for-gem/", label: "Digital signature support" },
  { href: "/enquire/?service=website-software", label: "Websites & software", intent: "website-software" },
  { href: "/enquire/?service=story", label: "Business stories", intent: "story" },
  { href: "/msme-benefits/", label: "Government schemes" },
];
const serviceActive = (link: typeof serviceLinks[number]) => link.intent
  ? currentPath === "/enquire" && currentService === link.intent : isActivePath(link.href);
const servicesCurrent = serviceLinks.some(serviceActive) || (currentPath === "/enquire" && ["gem", "registration", "catalogue", "dsc", "bid", "benefits", "tn-tender"].includes(currentService || ""));
const readingLinks = [
  { href: "/stories/", label: "Stories" }, { href: "/intelligence/", label: "Intelligence" },
  { href: "/guides/", label: "Guides" }, { href: "/the-room/", label: "The Room" },
];
---
<header class="site-header">
  <div class="wrap site-header__bar">
    <a class="wordmark" href="/" aria-label="Porul.in home" aria-current={isActivePath("/") ? "page" : undefined}>
      <span class="wordmark__mark">Porul<span class="wordmark__dot">.</span>in</span><span class="wordmark__tamil" lang="ta">பொருள்</span>
    </a>
    <nav class="nav-wide" aria-label="Primary">
      <ul class="nav-wide__list">
        <li><details class="services" data-current={servicesCurrent || undefined}>
          <summary class="nav-link">Services <span class="menu-marker menu-marker--closed" aria-hidden="true">+</span><span class="menu-marker menu-marker--open" aria-hidden="true">−</span></summary>
          <div class="services__panel panel"><ul class="services__list">{serviceLinks.map(link => <li><a class="nav-link" href={link.href} aria-current={serviceActive(link) ? "page" : undefined}>{link.label}</a></li>)}</ul></div>
        </details></li>
        {readingLinks.map(link => <li><a class="nav-link" href={link.href} aria-current={isActivePath(link.href) ? "page" : undefined}>{link.label}</a></li>)}
        <li><a class="button" href="/enquire/" aria-current={currentPath === "/enquire" && !currentService ? "page" : undefined}>Enquire</a></li>
      </ul>
    </nav>
    <a class="nav-link nav-tamil" href="/ta/" lang="ta" hreflang="ta" aria-current={isActivePath("/ta/") ? "page" : undefined}>தமிழ்</a>
    <details class="menu nav-compact">
      <summary class="menu__summary" aria-controls="primary-menu-panel">Menu <span class="menu-marker menu-marker--closed" aria-hidden="true">+</span><span class="menu-marker menu-marker--open" aria-hidden="true">−</span></summary>
      <nav class="menu__panel panel" id="primary-menu-panel" aria-label="Menu">
        <ul class="menu__list">
          <li><details class="services" data-current={servicesCurrent || undefined}>
            <summary class="nav-link">Services <span class="menu-marker menu-marker--closed" aria-hidden="true">+</span><span class="menu-marker menu-marker--open" aria-hidden="true">−</span></summary>
            <div class="services__panel"><ul class="services__list">{serviceLinks.map(link => <li><a class="nav-link" href={link.href} aria-current={serviceActive(link) ? "page" : undefined}>{link.label}</a></li>)}</ul></div>
          </details></li>
          {readingLinks.map(link => <li><a class="nav-link" href={link.href} aria-current={isActivePath(link.href) ? "page" : undefined}>{link.label}</a></li>)}
          <li><a class="button" href="/enquire/" aria-current={currentPath === "/enquire" && !currentService ? "page" : undefined}>Discuss your requirement</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>
<style>
  .site-header { background: var(--surface-0); border-bottom: var(--border-width-active) solid var(--text-primary); }
  .site-header__bar { display: flex; flex-wrap: wrap; align-items: center; gap: var(--label-gap); padding-block: var(--space-4); }
  .wordmark { display: inline-flex; align-items: center; min-height: var(--control-height); flex-shrink: 0; gap: var(--space-3); color: var(--text-primary); text-decoration: none; }
  .wordmark__mark { font-family: var(--font-brand); font-size: var(--type-wordmark); font-weight: var(--weight-brand); line-height: var(--leading-control); letter-spacing: var(--tracking-normal); }
  .wordmark__dot { color: var(--accent); }
  .wordmark__tamil { font-family: var(--font-tamil-ui); font-size: var(--type-control); font-weight: var(--weight-semibold); line-height: var(--leading-control); }
  .nav-wide { display: var(--nav-wide-display); flex: 1; min-width: var(--width-zero); justify-content: flex-end; }
  .nav-wide__list { display: flex; flex-wrap: wrap; align-items: flex-start; gap: var(--label-gap); }
  .nav-wide__list, .services__list, .menu__list { margin: var(--space-0); padding: var(--space-0); list-style: none; }
  .nav-wide__list > li { min-width: var(--width-zero); max-width: var(--width-full); }
  .nav-link { display: inline-flex; align-items: center; gap: var(--label-gap); min-height: var(--control-height); max-width: var(--width-full); padding: var(--space-2); font-family: var(--font-ui); font-size: var(--type-control); font-weight: var(--weight-semibold); line-height: var(--leading-control); color: var(--text-primary); text-decoration: none; border-radius: var(--radius-control); overflow-wrap: anywhere; }
  .nav-link:hover, .nav-link[aria-current="page"], .services[data-current] > summary { color: var(--accent); }
  .nav-tamil { margin-inline-start: auto; flex-shrink: 0; }
  .nav-compact { display: var(--nav-compact-display); }
  .menu { flex-direction: column; min-width: var(--width-zero); max-width: var(--width-full); }
  .menu[open] { flex-basis: var(--width-full); }
  .menu > summary { align-self: flex-end; }
  summary { cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .menu-marker { display: inline-block; font-family: var(--font-ui); font-weight: var(--weight-regular); }
  details:not([open]) > summary > .menu-marker--open,
  details[open] > summary > .menu-marker--closed { display: none; }
  .menu__summary { display: inline-flex; align-items: center; justify-content: center; gap: var(--label-gap); min-height: var(--control-height); padding: var(--control-padding-y) var(--control-padding-x); border: var(--border-width) solid var(--control-border); border-radius: var(--radius-control); color: var(--control-text); background: var(--control-surface); font-family: var(--font-ui); font-size: var(--type-control); font-weight: var(--weight-semibold); line-height: var(--leading-control); }
  .menu__summary:hover { border-color: var(--control-border-hover); }
  .menu__panel { width: var(--width-full); max-width: var(--width-full); margin-top: var(--space-4); }
  .menu__list, .services__list { display: grid; gap: var(--label-gap); }
  .services__panel { width: var(--width-full); max-width: var(--nav-panel-width); margin-top: var(--space-2); }
  .menu .services__panel { padding-inline-start: var(--space-4); border-inline-start: var(--border-width) solid var(--border); }
</style>
<script>
  // Escape closes the nearest open header disclosure, then returns its focus.
  const header = document.querySelector<HTMLElement>(".site-header");
  header?.addEventListener("keydown", event => {
    if (event.key !== "Escape" || !(event.target instanceof Element)) return;
    let menu = event.target.closest<HTMLDetailsElement>("details");
    while (menu && header.contains(menu) && !menu.open) menu = menu.parentElement?.closest<HTMLDetailsElement>("details") ?? null;
    if (!menu || !header.contains(menu) || !menu.open) return;
    menu.open = false;
    menu.querySelector<HTMLElement>(":scope > summary")?.focus();
    event.preventDefault();
    event.stopPropagation();
  });
</script>
