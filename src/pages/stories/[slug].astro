---
import { getCollection, render } from "astro:content";
import ArticleEndNote from "@/components/ArticleEndNote.astro";
import ArticleHeader from "@/components/ArticleHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Prose from "@/components/Prose.astro";
import ReportingNote from "@/components/ReportingNote.astro";

export async function getStaticPaths() {
  const stories = await getCollection("stories", ({ data }) => !data.draft);
  return stories.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const kicker = `Company story · ${entry.data.location} · ${entry.data.readingMinutes} min`;
---

<BaseLayout
  layout="editorial"
  title={entry.data.title}
  description={entry.data.dek}
  article={{
    headline: entry.data.title,
    authorship: entry.data.authorship,
    producerName: entry.data.producerName,
    sponsored: entry.data.sponsored,
    sponsorName: entry.data.sponsorName,
    publishDate: entry.data.publishDate,
    updatedDate: entry.data.updatedDate,
    image: entry.data.heroImage?.src,
    inLanguage: "en",
    section: "Company stories"
  }}
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Stories", path: "/stories/" },
    { name: entry.data.title, path: `/stories/${entry.data.slug}/` }
  ]}
>
  <article class="wrap">
    <ArticleHeader
      {...entry.data}
      kicker={kicker}
      title={entry.data.title}
      dek={entry.data.dek}
      sponsored={entry.data.sponsored}
      author={entry.data.author}
      authorRole={entry.data.authorRole}
      publishDate={entry.data.publishDate}
      updatedDate={entry.data.updatedDate}
    />
    {
      entry.data.heroImage && (
        <figure class="article-media">
          <div class="article-image">
            <img
              src={entry.data.heroImage.src}
              width={entry.data.heroImage.width}
              height={entry.data.heroImage.height}
              alt={entry.data.heroImageAlt}
              loading="eager"
            />
          </div>
          {entry.data.heroImageCaption && <figcaption>{entry.data.heroImageCaption}</figcaption>}
        </figure>
      )
    }
    {
      entry.data.reportingNote && (
        <ReportingNote
          authorship={entry.data.authorship}
          reportingNote={entry.data.reportingNote}
          verificationNote={entry.data.verificationNote}
          sponsored={entry.data.sponsored}
        />
      )
    }
    <Prose>
      <Content />
    </Prose>
    <ArticleEndNote />
  </article>
</BaseLayout>

<style>
  .article-media {
    width: var(--width-full);
    margin: var(--space-0) var(--space-0) var(--space-8);
  }

  .article-image {
    overflow: hidden;
    background: var(--surface-2);
  }

  .article-image img {
    display: block;
    width: var(--width-full);
    height: auto;
  }

  figcaption {
    margin-top: var(--space-2);
    color: var(--text-secondary);
    font-family: var(--font-ui);
    font-size: var(--type-meta);
    line-height: var(--leading-meta);
  }
</style>
