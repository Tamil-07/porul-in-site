---
import { getCollection, render } from "astro:content";
import ArticleEndNote from "@/components/ArticleEndNote.astro";
import ArticleHeader from "@/components/ArticleHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Prose from "@/components/Prose.astro";
import ReportingNote from "@/components/ReportingNote.astro";

export async function getStaticPaths() {
  const stories = await getCollection("stories", ({ data }) => !data.draft);
  return stories.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const kicker = `Company story · ${entry.data.location} · ${entry.data.readingMinutes} min`;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.dek}
  article={{
    headline: entry.data.title,
    publishDate: entry.data.publishDate,
    updatedDate: entry.data.updatedDate,
    image: entry.data.heroImage?.src,
    inLanguage: "en",
    section: "Company stories"
  }}
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Stories", path: "/stories/" },
    { name: entry.data.title, path: `/stories/${entry.data.slug}/` }
  ]}
>
  <article class="wrap">
    <ArticleHeader
      kicker={kicker}
      title={entry.data.title}
      dek={entry.data.dek}
      sponsored={entry.data.sponsored}
      author={entry.data.author}
      authorRole={entry.data.authorRole}
      publishDate={entry.data.publishDate}
      updatedDate={entry.data.updatedDate}
    />
    {
      entry.data.heroImage && (
        <figure class="article-media">
          <div class="article-image cham">
            <img
              src={entry.data.heroImage.src}
              width={entry.data.heroImage.width}
              height={entry.data.heroImage.height}
              alt={entry.data.heroImageAlt}
              loading="eager"
            />
          </div>
          <figcaption>Image supplied by Orbit Laser Cutting and cropped from the company's profile.</figcaption>
        </figure>
      )
    }
    {
      entry.data.reportingNote && (
        <ReportingNote
          reportingNote={entry.data.reportingNote}
          verificationNote={entry.data.verificationNote}
          sponsored={entry.data.sponsored}
        />
      )
    }
    <Prose>
      <Content />
    </Prose>
    <ArticleEndNote />
  </article>
</BaseLayout>

<style>
  .article-media {
    width: min(100%, 960px);
    margin: 0 0 36px;
  }

  .article-image {
    --cham: 22px;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface-raised);
  }

  .article-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 100%;
    filter: saturate(0.78) contrast(1.05);
    transform: scale(1.45);
    transform-origin: 62% 100%;
  }

  figcaption {
    margin-top: var(--space-2);
    color: var(--text-muted);
    font-size: 12px;
  }
</style>
