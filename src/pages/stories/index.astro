---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import StoryCard from "@/components/StoryCard.astro";

const stories = (await getCollection("stories", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
---

<BaseLayout title="Stories — Porul.in" description="Narrative company stories from Tamil Nadu precision engineering shops.">
  <section class="page-intro">
    <div class="wrap">
      <p class="page-intro__kicker">Company stories</p>
      <h1>The shops, told properly.</h1>
      <p class="page-intro__dek">Reported narratives from Tamil Nadu precision engineering. No supplier listings, no capability tables, no matching.</p>
    </div>
  </section>

  <section class="page-band" aria-label="Published stories">
    <div class="wrap">
      <div class="cards">
        {
          stories.length > 0 ? (
            stories.map((story) => (
              <StoryCard
                title={story.data.title}
                dek={story.data.dek}
                location={story.data.location}
                readingMinutes={story.data.readingMinutes}
                slug={story.data.slug}
                sponsored={story.data.sponsored}
              />
            ))
          ) : (
            <p class="empty-state cham">Stories are published as they are reported — no treadmill.</p>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
