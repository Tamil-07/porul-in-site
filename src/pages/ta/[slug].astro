---
import { getCollection, render } from "astro:content";
import ArticleEndNote from "@/components/ArticleEndNote.astro";
import ArticleHeader from "@/components/ArticleHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Prose from "@/components/Prose.astro";
import KeyTakeaway from "@/components/KeyTakeaway.astro";
import SourceList from "@/components/SourceList.astro";

export async function getStaticPaths() {
  const articles = await getCollection("tamil", ({ data }) => !data.draft);
  return articles.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const kicker = `${entry.data.category} · ${entry.data.location} · ${entry.data.readingMinutes} min`;
---

<BaseLayout
  lang="ta"
  title={entry.data.title}
  description={entry.data.dek}
  article={{
    headline: entry.data.title,
    publishDate: entry.data.publishDate,
    updatedDate: entry.data.updatedDate,
    image: entry.data.heroImage?.src,
    inLanguage: "ta",
    section: entry.data.category
  }}
  breadcrumbs={[
    { name: "முகப்பு", path: "/" },
    { name: "தமிழ்", path: "/ta/" },
    { name: entry.data.title, path: `/ta/${entry.data.slug}/` }
  ]}
>
  <article class="wrap">
    <ArticleHeader
      kicker={kicker}
      title={entry.data.title}
      dek={entry.data.dek}
      sponsored={entry.data.sponsored}
      author={entry.data.author}
      authorRole={entry.data.authorRole}
      publishDate={entry.data.publishDate}
      updatedDate={entry.data.updatedDate}
      lang="ta"
    />
    {
      entry.data.heroImage && (
        <img
          class="article-image cham"
          src={entry.data.heroImage.src}
          width={entry.data.heroImage.width}
          height={entry.data.heroImage.height}
          alt={entry.data.heroImageAlt}
          loading="eager"
        />
      )
    }
    <KeyTakeaway text={entry.data.keyTakeaway} />
    <Prose variant="tamil">
      <Content />
    </Prose>
    <SourceList sources={entry.data.sources} />
    <ArticleEndNote />
  </article>
</BaseLayout>

<style>
  .article-image {
    --cham: 22px;
    display: block;
    width: min(100%, 960px);
    height: auto;
    margin: 0 0 36px;
  }
</style>
