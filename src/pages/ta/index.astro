---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import IntelCard from "@/components/IntelCard.astro";

const articles = (await getCollection("tamil", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
---

<BaseLayout lang="ta" title="தமிழ் — Porul.in" description="தமிழில் Porul.in கட்டுரைகள்.">
  <section class="page-intro">
    <div class="wrap">
      <p class="page-intro__kicker">பொருள் · தமிழ்</p>
      <h1>தமிழில் தொழில் குறிப்புகள்.</h1>
      <p class="page-intro__dek">Tamil Nadu precision engineering பற்றிய Porul.in தமிழ் கட்டுரைகள் இங்கே வெளியாகும். இது Porul.in-இன் நேரடி தமிழ் பகுதி.</p>
    </div>
  </section>

  <section class="page-band" aria-label="Published Tamil articles">
    <div class="wrap">
      <div class="cards">
        {
          articles.length > 0 ? (
            articles.map((item) => (
              <IntelCard
                title={item.data.title}
                dek={item.data.dek}
                category={item.data.category}
                readingMinutes={item.data.readingMinutes}
                publishDate={item.data.publishDate}
                updatedDate={item.data.updatedDate}
                slug={item.data.slug}
                sponsored={item.data.sponsored}
                basePath="/ta"
                readLabel="கட்டுரையைப் படிக்க"
              />
            ))
          ) : (
            <p class="empty-state cham" role="status">தமிழ் கட்டுரைகள் இன்னும் வெளியிடப்படவில்லை. இந்தப் பகுதி செயல்பாட்டில் உள்ளது; மதிப்பாய்வு செய்யப்பட்ட கட்டுரைகள் மட்டும் இங்கே வெளியாகும்.</p>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
