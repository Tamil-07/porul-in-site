---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Prose from "@/components/Prose.astro";
import ArticleEndNote from "@/components/ArticleEndNote.astro";
import { dscGuideFaqs } from "@/data/dsc";
import { whatsappUrl } from "@/data/contact";
import "@/styles/services.css";

const title = "Do You Need a DSC for GeM Bidding?";
const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Guides", path: "/guides/" },
  { name: "DSC for GeM bidding", path: "/guides/is-dsc-mandatory-for-gem/" }
];
---
<BaseLayout layout="editorial"
  title={title}
  description="Check whether your GeM registration, bid or signing step needs a DSC, what to look for in the bid document and what to arrange before the deadline."
  article={{ headline: title, publishDate: "2026-09-29", updatedDate: "2026-09-30", section: "GeM service guides" }}
  faqs={dscGuideFaqs}
  breadcrumbs={breadcrumbs}
>
  <Prose>
  <article class="service-page">
    <header class="service-intro"><div class="wrap dsc-reading-wrap">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/guides/">Guides</a><span aria-hidden="true">/</span><span>DSC for GeM bidding</span></nav>
      <p class="eyebrow">Practical GeM guide</p>
      <h1>Do you need a DSC for a GeM bid?</h1>
      <p class="intro-copy"><strong>Check the bid and the final submission step.</strong> GeM supports OTP, eSign and Digital Signature Certificate routes. A particular bid can still require the authorised signatory to use a valid DSC.</p>
      <p class="fine">By Porul.in · Published 29 September 2026 · Updated 30 September 2026 · Reviewed by Porul's MSME and GeM portal specialist</p>
      <div class="actions"><a class="button button--dark" href="#quick-check">Check your situation →</a><a href="/digital-signature-for-gem/">See Porul's Class 3 DSC service</a></div>
    </div></header>

    <section class="service-band" id="quick-check"><div class="wrap dsc-reading-wrap">
      <p class="eyebrow">Quick answer</p>
      <h2>Registration and bidding are different decisions.</h2>
      <div class="dsc-answer-list">
        <article><h3>Opening a seller account</h3><p>Use the verification method shown in the current GeM registration and profile workflow. Do not buy a DSC only because you are creating an account.</p></article>
        <article><h3>Submitting a bid</h3><p>Read the bid document, additional terms and the instruction at submission. If they ask for a DSC, arrange it for the correct authorised signatory before the closing date.</p></article>
        <article><h3>Signing another transaction</h3><p>Follow the method the live portal presents. OTP or eSign may be available for some actions; a DSC may be required for others.</p></article>
      </div>
    </div></section>

    <section class="service-band" aria-labelledby="search-title"><div class="wrap service-split">
      <div>
        <p class="eyebrow">Inside the bid PDF</p>
        <h2 id="search-title">Search for the signing instruction.</h2>
        <p>Download the current bid document and any additional terms or corrigenda. Search for these phrases:</p>
        <ul class="dsc-keywords"><li>DSC</li><li>Digital Signature Certificate</li><li>digital signature</li><li>authorised signatory</li><li>eSign</li></ul>
      </div>
      <div class="dsc-evidence-card">
        <h3>Save the evidence</h3>
        <p>Keep the page number or screenshot that states the signing method. If the portal instruction and bid wording appear different, use GeM's current support route before the deadline.</p>
        <p>Do not rely only on an old tutorial or a generic article. The current bid and portal workflow govern the submission.</p>
      </div>
    </div></section>

    <section class="service-band" aria-labelledby="before-title"><div class="wrap service-split">
      <div><p class="eyebrow">If a DSC is required</p><h2 id="before-title">Confirm four details before ordering.</h2><p>These checks reduce the risk of applying for the wrong person or discovering a setup problem close to the deadline.</p></div>
      <ol class="service-steps dsc-process">
        <li><strong>The signer.</strong><span> Confirm the person authorised to sign for the business.</span></li>
        <li><strong>The certificate.</strong><span> Check the class, signing or encryption requirement and any instruction in the bid.</span></li>
        <li><strong>The validity.</strong><span> Choose the suitable validity period after considering upcoming filings and bids.</span></li>
        <li><strong>The setup window.</strong><span> Leave time for KYC, certificate issuance, token delivery, installation and a test.</span></li>
      </ol>
    </div></section>

    <section class="service-band" aria-labelledby="porul-title"><div class="wrap service-split">
      <div>
        <p class="eyebrow">Porul's service</p>
        <h2 id="porul-title">Class 3 signing and encryption DSC.</h2>
        <p>Porul provides a two-year or three-year certificate with a HYP2003 or Precision USB token. The customer also receives a setup tutorial and a renewal reminder.</p>
        <p><a href="/digital-signature-for-gem/">See the full DSC package and fulfilment process →</a></p>
      </div>
      <div>
        <h2>How the application moves</h2>
        <p>Message Porul, receive a callback, confirm the applicant, complete KYC, then receive the certificate and token. GeM registration and portal support can be added when needed.</p>
        <p><a href={whatsappUrl("Hello Porul, my GeM bid appears to require a DSC. Please call me back to confirm the applicant and process.")}>Ask Porul to call you back →</a></p>
      </div>
    </section>

    <section class="service-band" aria-labelledby="review-title"><div class="wrap dsc-reading-wrap">
      <p class="eyebrow">Why you can rely on this guide</p>
      <h2 id="review-title">Written from the portal rules and the work Porul performs.</h2>
      <p>The answer above is based on GeM's published eSign and DSC material and Porul's current DSC fulfilment process. It was reviewed by Porul's MSME and GeM portal specialist, who has five years of experience working with MSMEs. The specialist's name is shared with customers during service delivery.</p>
      <p>Porul provides DSCs through Finbees Consulting, a partner of eMudhra, PantaSign and Capricorn. Porul is independent of GeM and the government.</p>
    </div></section>

    <section class="service-band" aria-labelledby="faq-title"><div class="wrap dsc-reading-wrap">
      <h2 id="faq-title">GeM DSC questions</h2>
      {dscGuideFaqs.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}
    </div></section>

    <section class="service-band" aria-labelledby="sources-title"><div class="wrap dsc-reading-wrap">
      <h2 id="sources-title">Official sources</h2>
      <ul>
        <li><a href="https://assets-bg.gem.gov.in/resources/upload/shared_doc/training_content/E-Sign-DSC-Process-1685708713.pdf">GeM eSign and DSC process workflow</a></li>
        <li><a href="https://gem.gov.in/userFaqs/seller">GeM seller FAQs</a></li>
        <li><a href="https://assets-bg.gem.gov.in/resources/upload/shared_doc/gtc/GeM-GTC-40-1740735825.pdf">GeM General Terms and Conditions</a></li>
        <li><a href="https://cca.gov.in/digital_signature.html">Controller of Certifying Authorities: how to obtain a DSC</a></li>
      </ul>
      <p class="fine">Sources reviewed 30 September 2026. Check the current GeM screen, bid document, corrigenda and additional conditions before submitting.</p>
    </div></section>

    <section class="service-band dsc-final-cta"><div class="wrap dsc-reading-wrap">
      <h2>Found a DSC requirement in your bid?</h2>
      <p>Send the bid link or ID, authorised-signatory role, preferred validity, delivery city and deadline. Do not send identity documents, passwords, OTPs or token PINs in the first message.</p>
      <div class="actions"><a class="button button--dark" href="/digital-signature-for-gem/">Review the DSC service →</a><a href="/enquire/?service=dsc">Prepare a DSC enquiry</a><a href="/guides/gem-seller-registration/">Read the seller registration guide</a></div>
      <p class="fine">For corrections, email <a href="mailto:hello@porul.in?subject=GeM%20DSC%20guide%20correction">hello@porul.in</a>.</p>
    </div></section>
    <ArticleEndNote />
  </article>
  </Prose>
</BaseLayout>
