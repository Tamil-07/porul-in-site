---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { benefitsFaqs, benefitsService, benefitsCopy as copy, schemeDeliverables } from "@/data/benefits";
import "@/styles/services.css";
const breadcrumbs = [{ name: "Home", path: "/" }, { name: "Government schemes", path: benefitsService.path }];
---
<BaseLayout layout="catalog" title={copy.title} description={copy.description} service={benefitsService} faqs={benefitsFaqs} breadcrumbs={breadcrumbs}>
  <div class="service-page">
    <section class="service-intro"><div class="wrap">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Government schemes</span></nav>
      <p class="eyebrow">For manufacturers in Tamil Nadu &amp; Karnataka</p><h1>{copy.heading}</h1><p class="intro-copy">{copy.intro}</p>
      <div class="actions"><a class="button" href="/enquire/?service=benefits">{copy.primary_action} <span aria-hidden="true">↗</span></a><a class="text-link" href="#scope">See what you receive <span aria-hidden="true">↓</span></a></div>
      <p class="fine">We agree the work and any fee before starting. The relevant authority decides eligibility and approval.</p>
    </div></section>
    <section class="service-band" id="scope" aria-labelledby="scope-title"><div class="wrap service-split">
      <div><h2 id="scope-title">{copy.scope_heading}</h2><p>{copy.scope_body}</p><p>Already registered? Read <a href="/guides/udyam-registration-next-steps/">what to check after Udyam registration</a>.</p></div>
      <div class="scheme-deliverables"><h2>What you receive</h2><ul>{schemeDeliverables.map(item => <li>{item}</li>)}</ul><p>The check can also find that no relevant scheme is available. A shortlist is not a promise of eligibility or funding.</p></div>
    </div></section>
    <section class="service-band"><div class="wrap service-split">
      <div><h2>{copy.limits_heading}</h2><p>{copy.limits_body}</p><p>For a separate portal need, see <a href="/gem-services/">GeM registration and product listing help</a>.</p></div>
      <div><h2>{copy.location_heading}</h2><p>{copy.location_body}</p><p>If you have already invested, see <a href="/guides/msme-incentives-after-machinery-purchase/">which machinery and production dates to collect</a>.</p></div>
    </div></section>
    <section class="service-band" aria-labelledby="first-details"><div class="wrap service-split"><h2 id="first-details">What to share first</h2><div><p>{copy.first_details_body}</p><a class="text-link" href="/privacy/">Read the enquiry privacy notice</a></div></div></section>
    <section class="service-band" aria-labelledby="faq-title"><div class="wrap"><h2 id="faq-title">Questions before you enquire</h2>{benefitsFaqs.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
    <section class="service-band" aria-labelledby="contact-title"><div class="wrap service-split"><h2 id="contact-title">{copy.final_heading}</h2><div><p>{copy.final_body}</p><div class="actions"><a class="button" href="/enquire/?service=benefits">{copy.primary_action} <span aria-hidden="true">↗</span></a><a class="text-link" href="/contact/">Other ways to contact Porul</a></div></div></div></section>
  </div>
</BaseLayout>
<style>
  .scheme-deliverables { padding: var(--panel-padding); background: var(--surface-2); }
  .scheme-deliverables li + li { margin-top: var(--space-3); }
  .scheme-deliverables p { font-size: var(--type-control); line-height: var(--leading-control); }
</style>
