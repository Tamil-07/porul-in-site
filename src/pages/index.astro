---
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import StoryCard from "@/components/StoryCard.astro";
import IntelCard from "@/components/IntelCard.astro";
import { schemeDeliverables } from "@/data/benefits";
import illustration from "@/assets/editorial/orbit-handoff-illustration.png";
import "@/styles/home.css";
const newest = (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime();
const [story] = (await getCollection("stories", ({ data }) => !data.draft)).sort(newest);
const [intelligence] = (await getCollection("intelligence", ({ data }) => !data.draft)).sort(newest);
const isOrbit = story?.data.slug === "orbit-laser-cutting";
const cover = isOrbit ? await getImage({ src: illustration, format: "webp" }) : undefined;
---
<BaseLayout layout="catalog" title="Porul.in — Practical Help for Small Manufacturers" description="GeM registration and product listings, website and software enquiries, government scheme checks, and free manufacturing stories and analysis.">
<div class="wrap home">

    <section class="hero" aria-labelledby="home-title">
      <div class="hero-lead">
        <p class="eyebrow">For small manufacturers</p>
        <h1 id="home-title">You make the product. Bring the next step to Porul.</h1>
      </div>
      <div class="hero-copy">
        <p>Get help with GeM registration and product listings. Talk to us about a website, software or a story about your business.</p>
        <div class="actions"><a class="button" href="/enquire/?service=gem">Talk to us about GeM</a><a class="text-link" href="/stories/">Read our stories</a></div>
      </div>
    </section>
    <nav class="tasks" aria-label="Start with a task"><a class="task-primary" href="#gem">GeM help <span aria-hidden="true">↓</span></a><a href="#website-software">Websites &amp; software <span aria-hidden="true">↓</span></a><a href="#story">Business stories <span aria-hidden="true">↓</span></a><a href="#schemes">Government schemes <span aria-hidden="true">↓</span></a></nav>
    <div class="services">
      <section class="service-main" id="gem" aria-labelledby="gem-title">
        <div class="service-heading">
        <p class="eyebrow">Start here · GeM</p>
        <h2 class="service-title" id="gem-title">Get ready to sell on GeM</h2>
        <a class="text-link" href="/gem-services/">See GeM services</a>
        </div>
        <div class="service-copy">
        <p class="service-body">We help you prepare your seller registration and product listings, or work through a rejected catalogue. Digital Signature Certificate support is available.</p>
        <p class="service-note">We agree the work and any fee before starting. Porul is independent of GeM and government. Approvals and orders are not guaranteed.</p>
        <div class="actions"><a class="button" href="/enquire/?service=gem">Talk to us about GeM</a><a class="text-link" href="/digital-signature-for-gem/">Digital Signature Certificate support</a></div>
        </div>
      </section>
      <div class="pair">
        <section class="route" id="website-software" aria-labelledby="web-title">
          <h2 class="route-title" id="web-title">A website or software for your business</h2>
          <p>Tell us what it needs to do. We’ll discuss whether we can help, what the work involves and the fee.</p>
          <a class="text-link" href="/enquire/?service=website-software">Discuss your project</a>
        </section>
        <section class="route" id="story" aria-labelledby="story-title">
          <h2 class="route-title" id="story-title">Have a business story worth telling?</h2>
          <p>Tell us about it, or ask about a commissioned article. Paid articles are labelled. Payment does not guarantee publication or buy editorial influence.</p>
          <a class="text-link" href="/enquire/?service=story">Discuss a story</a>
        </section>
      </div>
      <section class="schemes" id="schemes" aria-labelledby="schemes-title">
        <div class="scheme-intro">
        <p class="eyebrow">Tamil Nadu &amp; Karnataka</p>
        <h2 class="service-title" id="schemes-title">Government schemes for your manufacturing unit</h2>
        <p>Starting a unit, buying machinery or expanding? We check central and state schemes against your unit’s details in Tamil Nadu or Karnataka. Already bought your machinery? We can check your options too.</p>
        <a class="text-link" href="/enquire/?service=benefits">Ask about government schemes</a>
        </div>
        <div class="scheme-output">
        <h3>What you receive</h3>
        <ul>{schemeDeliverables.map(item => <li>{item}</li>)}</ul>
        <p class="scheme-limit">We don’t file applications or arrange loans. Authorities decide eligibility and approval.</p>
        <a class="text-link" href="/msme-benefits/">How the scheme check works</a>
        </div>
      </section>
    </div>
    <section class="publication" aria-labelledby="pub-title">
      <div class="pub-head"><h2 id="pub-title">From the publication</h2><span class="pub-free">Free to read</span></div>
      <div class="pub-body">
        <div class="lead-story">{story ? <StoryCard {...story.data} featured headingLevel={3} heroImage={cover?.src ?? story.data.heroImage?.src} heroImageAlt={isOrbit ? "Conceptual editorial illustration of a sheet-metal job moving between cutting and dispatch." : story.data.heroImageAlt} heroImageWidth={isOrbit ? illustration.width : story.data.heroImage?.width} heroImageHeight={isOrbit ? illustration.height : story.data.heroImage?.height} heroImageCaption={isOrbit ? "Conceptual editorial illustration, generated with AI. Not a photograph of Orbit Laser Cutting." : story.data.heroImageCaption} /> : <p>Stories appear as they are reported.</p>}</div>
        <div class="analysis">{intelligence ? <IntelCard {...intelligence.data} headingLevel={3} /> : <p>Industry analysis appears when published.</p>}</div>
      </div>
      <p class="pub-more"><a class="text-link" href="/stories/">Explore stories</a><a class="text-link" href="/intelligence/">Explore intelligence</a></p>
    </section>
    <section class="closing" aria-labelledby="closing-title">
      <div class="closing-copy">
        <h2 class="closing-title" id="closing-title">Tell us what your business needs</h2>
        <p>What do you make? Where is your unit? What do you need help with?</p>
        <p>We agree the work and any fee before starting.</p>
      </div>
      <a class="button" href="/enquire/">Talk to Porul</a>
    </section>
  
</div>
</BaseLayout>
