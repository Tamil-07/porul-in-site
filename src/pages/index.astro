---
// Services lead; editorial records remain independent of service proof.
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/Hero.astro";
import { benefitsFaqs } from "@/data/benefits";
import { whatsappUrl } from "@/data/contact";
import "@/styles/home.css";
const stories = await getCollection("stories", ({ data }) => !data.draft);
const intelligence = await getCollection("intelligence", ({ data }) => !data.draft);
const reading = [...stories.map(item => ({ ...item, section: "stories", label: "Company story" })), ...intelligence.map(item => ({ ...item, section: "intelligence", label: "Intelligence" }))].sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
const guides = [
  { href: "/guides/udyam-registration-next-steps/", title: "Udyam registration is done. What benefits should you check?" },
  { href: "/guides/msme-incentives-after-machinery-purchase/", title: "Already bought machinery or started production?" },
  { href: "/guides/gem-catalogue-rejected/", title: "GeM catalogue rejected? Check before resubmitting" },
  { href: "/guides/gem-seller-registration/", title: "GeM seller registration: what to prepare" }
];
const date = (value: Date) => value.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
---
<BaseLayout title="Porul.in — MSME Benefits Review & GeM Support" description="Explore MSME benefits for manufacturing businesses in Tamil Nadu and Karnataka. Porul reviews relevant schemes and next steps. GeM support also available." faqs={benefitsFaqs}>
  <Hero />
  <section class="home-band home-band--raised" id="work" aria-labelledby="work-title"><div class="wrap">
    <h2 id="work-title">How Porul can help</h2>
    <div class="service-records">
      <article class="service-record"><div><p class="kicker">01 / MSME benefits</p><h3>What support could apply to your unit?</h3><span class="status status--available">Available · Tamil Nadu &amp; Karnataka</span></div><div><p>Starting production, buying machinery or planning an expansion? We review the central and state schemes that may fit your manufacturing business and explain the conditions to check.</p><p class="fine">Approval rests with the relevant authority. A review does not guarantee eligibility, a subsidy or payment.</p><a class="text-link" href="/enquire/?service=benefits">Discuss MSME benefits →</a><p class="fine"><a href="/msme-benefits/">See the benefits review scope, including Coimbatore, Hosur and Chennai →</a></p></div></article>
      <article class="service-record"><div><p class="kicker">02 / Government e-Marketplace</p><h3>Get help with the GeM portal work.</h3><span class="status status--available">Registration &amp; catalogues available</span></div><div><p>Seller registration, product listings or catalogue corrections. For a specific bid or Tamil Nadu tender, send the official link and deadline for a capability and scope review.</p><p class="fine">Independent assistance, not a government service. Registration does not guarantee orders.</p><a class="text-link" href="/gem-services/">GeM services, scope &amp; FAQs →</a></div></article>
    </div>
    <p class="other-needs"><strong>Something else?</strong> Business profiles, certification, exhibitions or compliance coordination: <a href="/enquire/?service=other">share the requirement</a>. We confirm whether we can help before offering support.</p>
  </div></section>
  <section class="home-band" aria-labelledby="review-title"><div class="wrap home-split">
    <div><p class="kicker">From a question to a next step</p><h2 id="review-title">What a benefits review can clarify</h2><p>Not just a list of schemes. The useful question is what to check for your unit, at its current stage.</p><p class="fine">Illustrative outline, not a sample assessment or a promise of eligibility. We confirm what yours will cover before we start.</p></div>
    <div class="assessment-outline">
      <details open><summary>01 — Schemes worth checking</summary><p>Potentially relevant central and state schemes, with links to official sources and the date checked.</p></details>
      <details><summary>02 — Conditions and exclusions</summary><p>Requirements to examine against your location, business activity and stage, including conditions that could rule a scheme out.</p></details>
      <details><summary>03 — Information still needed</summary><p>Questions or records needed before a firmer conclusion can be reached. Missing information stays visible.</p></details>
      <details><summary>04 — Next steps and timing</summary><p>What to check next, where to check it and which published deadlines need attention.</p></details>
      <p class="fine">An assessment does not include filing applications, dealing with departments, appeals or arranging loans. Any additional work needs a separate capability and scope review.</p>
    </div>
  </div></section>
  <section class="home-band home-band--raised" aria-labelledby="process-title"><div class="wrap">
    <h2 id="process-title">How it works</h2>
    <ol class="home-steps"><li><span class="kicker">01</span><h3>Tell us about your unit.</h3><p>What you manufacture, where you operate and whether you are planning, producing or expanding. No sensitive documents needed to start.</p></li><li><span class="kicker">02</span><h3>Agree the scope first.</h3><p>We review the requirement and confirm what we can do, what information is needed and any fee before work begins.</p></li><li><span class="kicker">03</span><h3>Receive the agreed work.</h3><p>The work follows the scope you approved. Unanswered questions and matters requiring official confirmation are identified.</p></li></ol>
    <div class="accountability"><p><strong>Prepared by Porul.</strong> Benefits reviews are provided through Porul.in. Shreepriya handles GeM portal work. Porul is an independent service provider, not a government body.</p><a class="text-link" href="/about/">About Porul &amp; our standards →</a></div>
  </div></section>
  <section class="home-band" aria-labelledby="questions-title"><div class="wrap home-split"><div><p class="kicker">Before you enquire</p><h2 id="questions-title">A few useful answers</h2></div><div class="home-faq">{benefitsFaqs.map(faq => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div></div></section>
  <section class="home-band editorial-wall" aria-labelledby="reading-title"><div class="wrap">
    <p class="kicker">Guides &amp; independent reporting</p><h2 id="reading-title">Read before you decide.</h2>
    <p class="reading-intro">Our <a href="/guides/">service guides</a> answer common questions about Porul's service areas. Company stories and intelligence are separate editorial work: paying for support does not buy coverage, and featured companies are not presented as Porul clients.</p>
    <ul class="reading-list">{guides.map(guide => <li><div><span class="fine">Service guide · Porul's own services</span><h3><a href={guide.href}>{guide.title}</a></h3></div><a class="text-link" aria-label={`Read ${guide.title}`} href={guide.href}>Read guide →</a></li>)}{reading.map(item => <li><div><span class="fine">{item.label} · Published <time datetime={item.data.publishDate.toISOString()}>{date(item.data.publishDate)}</time>{item.data.updatedDate && <> · Updated <time datetime={item.data.updatedDate.toISOString()}>{date(item.data.updatedDate)}</time></>}</span><h3><a href={`/${item.section}/${item.data.slug}/`}>{item.data.title}</a></h3>{item.data.sponsored && <p class="fine">Sponsored</p>}</div><a class="text-link" aria-label={`Read ${item.data.title}`} href={`/${item.section}/${item.data.slug}/`}>Read →</a></li>)}</ul>
    {reading.length === 0 && <p>No editorial articles are published yet.</p>}
    <nav class="home-links" aria-label="Publication"><a href="/stories/">All stories →</a><a href="/intelligence/">Sector intelligence →</a><a href="/about/#editorial-standards">Sources, disclosures &amp; corrections →</a></nav>
  </div></section>
  <section class="home-band home-band--raised" aria-labelledby="beyond-title"><div class="wrap"><h2 id="beyond-title">Beyond the service enquiry</h2><div class="home-split">
    <div><h3>Language sections</h3><a class="text-link" href="/ta/" lang="ta">தமிழ் →</a><p>No Tamil articles are published yet. The section is active and will carry reviewed Tamil work.</p></div>
    <div><h3>The Room</h3><p>A small, reviewed room for people working in Tamil Nadu CNC and precision engineering. Members receive a weekly digest and early access to Porul.in sector intelligence before public publication.</p><p class="fine">Not vendor registration, an RFQ, sourcing or a sales-enquiry channel.</p><a class="text-link" href="/the-room/">About The Room &amp; how to apply →</a></div>
  </div></div></section>
  <section class="home-band" aria-labelledby="enquiry-title"><div class="wrap home-split"><div><p class="kicker">Your next step</p><h2 id="enquiry-title">Start with your unit.<br />We’ll discuss what to check.</h2></div><div><p>Tell us what you manufacture, your location and your current stage. We confirm the scope and any fee before an assessment begins.</p><a class="button button--dark" href="/enquire/?service=benefits">Discuss MSME benefits →</a><p class="fine">Prepare a message to send on WhatsApp or email. Prefer to write directly? <a href={whatsappUrl()}>Chat on WhatsApp</a> or email <a href="mailto:hello@porul.in">hello@porul.in</a>.</p></div></div></section>
</BaseLayout>
