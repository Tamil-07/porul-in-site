---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/Hero.astro";
import IntelCard from "@/components/IntelCard.astro";
import MarqueeStrip from "@/components/MarqueeStrip.astro";
import RoomPanel from "@/components/RoomPanel.astro";
import SectionHead from "@/components/SectionHead.astro";
import StoryCard from "@/components/StoryCard.astro";

const byRecent = (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime();

const stories = (await getCollection("stories", ({ data }) => !data.draft)).sort(byRecent).slice(0, 3);
const intelligence = (await getCollection("intelligence", ({ data }) => !data.draft)).sort(byRecent).slice(0, 3);
---

<BaseLayout>
  <Hero />
  <MarqueeStrip />

  <section class="section" aria-labelledby="latest-stories">
    <div class="wrap">
      <SectionHead headingId="latest-stories" kicker="01 — Latest stories" title="The shops, told properly." href="/stories/" linkLabel="All stories" />
      <div class="cards">
        {
          stories.length > 0 ? (
            stories.map((story) => (
              <StoryCard
                title={story.data.title}
                dek={story.data.dek}
                location={story.data.location}
                readingMinutes={story.data.readingMinutes}
                slug={story.data.slug}
                sponsored={story.data.sponsored}
              />
            ))
          ) : (
            <p class="empty-state cham">Stories are published as they are reported — no treadmill.</p>
          )
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="latest-intelligence">
    <div class="wrap">
      <SectionHead headingId="latest-intelligence" kicker="02 — Intelligence &amp; the digest" title="The signals buyers act on." href="/intelligence/" linkLabel="All intelligence" />
      <div class="cards">
        {
          intelligence.length > 0 ? (
            intelligence.map((item) => (
              <IntelCard
                title={item.data.title}
                dek={item.data.dek}
                category={item.data.category}
                readingMinutes={item.data.readingMinutes}
                slug={item.data.slug}
                sponsored={item.data.sponsored}
              />
            ))
          ) : (
            <p class="empty-state cham">Intelligence is published when there is something durable to say.</p>
          )
        }
      </div>
    </div>
  </section>

  <RoomPanel />
</BaseLayout>
