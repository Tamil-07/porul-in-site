---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import IntelCard from "@/components/IntelCard.astro";

const intelligence = (await getCollection("intelligence", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
---

<BaseLayout title="Intelligence — Porul.in" description="Durable sector intelligence for Tamil Nadu precision engineering.">
  <section class="page-intro">
    <div class="wrap">
      <p class="page-intro__kicker">Intelligence &amp; digest</p>
      <h1>The signals buyers act on.</h1>
      <p class="page-intro__dek">Materials, capacity, policy, demand, and digest notes for Tamil Nadu precision engineering, published only when useful.</p>
    </div>
  </section>

  <section class="page-band" aria-label="Published intelligence">
    <div class="wrap">
      <div class="cards">
        {
          intelligence.length > 0 ? (
            intelligence.map((item) => (
              <IntelCard
                title={item.data.title}
                dek={item.data.dek}
                category={item.data.category}
                readingMinutes={item.data.readingMinutes}
                slug={item.data.slug}
                sponsored={item.data.sponsored}
              />
            ))
          ) : (
            <p class="empty-state cham">Intelligence is published when there is something durable to say.</p>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
