---
import { getCollection, render } from "astro:content";
import ArticleEndNote from "@/components/ArticleEndNote.astro";
import ArticleHeader from "@/components/ArticleHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Prose from "@/components/Prose.astro";
import KeyTakeaway from "@/components/KeyTakeaway.astro";
import SourceList from "@/components/SourceList.astro";

export async function getStaticPaths() {
  const intelligence = await getCollection("intelligence", ({ data }) => !data.draft);
  return intelligence.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const kicker = `${entry.data.category} · ${entry.data.location} · ${entry.data.readingMinutes} min`;
---

<BaseLayout
  layout="editorial"
  title={entry.data.title}
  description={entry.data.dek}
  article={{
    headline: entry.data.title,
    authorship: entry.data.authorship,
    producerName: entry.data.producerName,
    sponsored: entry.data.sponsored,
    sponsorName: entry.data.sponsorName,
    publishDate: entry.data.publishDate,
    updatedDate: entry.data.updatedDate,
    image: entry.data.heroImage?.src,
    inLanguage: "en",
    section: entry.data.category
  }}
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Intelligence", path: "/intelligence/" },
    { name: entry.data.title, path: `/intelligence/${entry.data.slug}/` }
  ]}
>
  <article class="wrap">
    <ArticleHeader
      {...entry.data}
      kicker={kicker}
      title={entry.data.title}
      dek={entry.data.dek}
      sponsored={entry.data.sponsored}
      author={entry.data.author}
      authorRole={entry.data.authorRole}
      publishDate={entry.data.publishDate}
      updatedDate={entry.data.updatedDate}
    />
    {
      entry.data.heroImage && (
        <img
          class="article-image"
          src={entry.data.heroImage.src}
          width={entry.data.heroImage.width}
          height={entry.data.heroImage.height}
          alt={entry.data.heroImageAlt}
          loading="eager"
        />
      )
    }
    <KeyTakeaway text={entry.data.keyTakeaway} />
    <Prose>
      <Content />
    </Prose>
    <SourceList sources={entry.data.sources} />
    <ArticleEndNote />
  </article>
</BaseLayout>

<style>
  .article-image {
    display: block;
    width: var(--width-full);
    height: auto;
    margin: var(--space-0) var(--space-0) var(--space-8);
  }
</style>
