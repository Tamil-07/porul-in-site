---
// Concise recovery paths within the shared catalog shell.
import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout layout="catalog" title="Page not found — Porul.in" description="The requested Porul.in page could not be found." canonicalPath="/404.html" noindex={true}>
  <section class="page-intro"><div class="wrap stack">
    <p class="page-intro__kicker">404 · Page not found</p><h1>We could not find that page.</h1><p class="page-intro__dek">The address may have changed, or the page may never have been published.</p>
    <div class="recovery-actions"><a class="button" href="/">Return home</a><a class="button button--ghost" href="/stories/">Read our stories</a><a class="text-link" href="/contact/">Contact Porul</a></div>
  </div></section>
</BaseLayout>
<style>
  .recovery-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--item-gap); }
</style>
