---
// Human-reviewed applications retain the four approved fit questions.
import BaseLayout from "@/layouts/BaseLayout.astro";
const questions = ["Your name and role", "Your company or organisation", "Your connection to Tamil Nadu precision engineering", "Why would The Room be useful to you?"];
const applicationSubject = encodeURIComponent("Application to The Room at Porul.in");
const applicationBody = encodeURIComponent(`Please answer these four questions:

1. Your name and role:
2. Your company or organisation:
3. Your connection to Tamil Nadu precision engineering:
4. Why would The Room be useful to you?

The Room is an editorial network. This is not vendor registration, an RFQ, a sourcing request, or a sales enquiry.`);
const entryEmail = `mailto:hello@porul.in?subject=${applicationSubject}&body=${applicationBody}`;
---
<BaseLayout layout="catalog" title="Apply to The Room — Porul.in" description="A small, reviewed room for people working in Tamil Nadu CNC and precision engineering. Apply with four questions; every application is read by a person.">
  <section class="page-intro"><div class="wrap">
    <p class="page-intro__kicker">The Room · Reviewed entry</p><h1>A small room. A useful exchange.</h1>
    <p class="page-intro__dek">For people working in Tamil Nadu CNC and precision engineering. Every application is read by a person and judged on fit.</p>
    <p><a class="button" href={entryEmail}>Apply to The Room</a></p>
    <p class="fine">Four short questions. Your email app opens a draft for you to review and send.</p>
  </div></section>
  <section class="page-band"><div class="wrap stack">
    <div class="room-grid">
      <section class="room-detail stack"><h2>Who it is for</h2><p>Procurement people who value signal over noise, and serious shops that understand credibility is built through conduct, not claims.</p></section>
      <section class="room-detail stack"><h2>Member benefits</h2><p>A weekly digest, and early access to Porul.in sector intelligence before public publication.</p></section>
      <section class="room-detail stack"><h2>What happens next</h2><p>A human reads every application. If the fit is clear, the founder follows up directly. There is no automated approval.</p></section>
      <section class="room-detail stack"><h2>The boundary</h2><p>We tell, explain and convene. We do not quote, match, source, broker or fulfil. This is not vendor registration, an RFQ, a sourcing request or a sales-enquiry channel.</p></section>
    </div>
    <section class="panel stack" aria-labelledby="application-title"><h2 id="application-title">Four questions to apply</h2><ol>{questions.map(question => <li>{question}</li>)}</ol><p><a class="button" href={entryEmail}>Apply to The Room</a></p><p class="fine">No email app? Copy the questions into your webmail and send your answers to <a href="mailto:hello@porul.in?subject=Application%20to%20The%20Room%20at%20Porul.in">hello@porul.in</a> with the subject “Application to The Room at Porul.in”.</p></section>
  </div></section>
</BaseLayout>
<style>
  .room-grid { display: grid; grid-template-columns: var(--grid-pair); gap: var(--group-gap); }
  .room-detail { border-top: var(--border-width) solid var(--border); padding-top: var(--item-gap); }
</style>
