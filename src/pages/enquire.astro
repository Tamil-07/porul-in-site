---
// Local draft composer: visitors review and send through their chosen app.
import BaseLayout from "@/layouts/BaseLayout.astro";
import { whatsappDisplay, whatsappUrl } from "@/data/contact";
const interests = [
  ["gem", "GeM support — help choosing the next step"], ["registration", "GeM seller registration"],
  ["catalogue", "Product listing or catalogue correction"], ["dsc", "Digital Signature Certificate for GeM"],
  ["bid", "A specific GeM bid"], ["website-software", "Website or software requirements"],
  ["story", "A story idea or commissioned piece"], ["benefits", "Government schemes for my unit"],
  ["tn-tender", "A Tamil Nadu tender scope review"], ["marketing", "Business profile, website or marketing"],
  ["certification", "Certification or audit preparation"], ["exhibitions", "Expo or exhibition preparation"],
  ["compliance", "Compliance coordination"], ["other", "Another task / help choosing the next step"],
];
---
<BaseLayout layout="form" title="Discuss your requirement — Porul.in" description="Prepare a WhatsApp or email enquiry about GeM, websites and software, stories or government schemes. Review and send the message yourself." breadcrumbs={[{ name: "Home", path: "/" }, { name: "Enquire", path: "/enquire/" }]}>
  <section class="page-intro"><div class="wrap">
    <p class="page-intro__kicker">Enquire</p><h1>Tell us what your business needs.</h1>
    <p class="page-intro__dek">Describe what you need help with. Prepare a message, then review and send it by WhatsApp or email.</p>
    <p class="fine">Prefer to write directly? <a href={whatsappUrl()}>WhatsApp {whatsappDisplay}</a> or email <a href="mailto:hello@porul.in">hello@porul.in</a>.</p>
  </div></section>
  <section class="page-band"><div class="wrap stack">
    <!-- Hidden until enhancement attaches: no accidental GET with personal data. -->
    <form id="enquiry-form" hidden novalidate>
      <div id="enquiry-errors" class="error-summary" hidden tabindex="-1" aria-labelledby="error-title"><h2 id="error-title">Check these details</h2><ul id="error-list"></ul></div>
      <div class="enquiry-fields">
        <label class="full" for="service">What do you need? <span class="fine">Required</span><select id="service" name="service" required aria-describedby="service-error"><option value="">Select a requirement</option>{interests.map(([value, label]) => <option value={value}>{label}</option>)}</select><span id="service-error" class="field-error" hidden></span></label>
        <label for="name">Your name <span class="fine">Required</span><input id="name" name="name" autocomplete="name" required maxlength="100" aria-describedby="name-error" /><span id="name-error" class="field-error" hidden></span></label>
        <label for="business">Business name <span class="fine">Optional</span><input id="business" name="business" autocomplete="organization" maxlength="120" /></label>
        <label for="contact-method">How can we contact you? <span class="fine">Required</span><select id="contact-method" name="contact-method" required aria-describedby="contact-method-error"><option value="">Select phone or email</option><option value="phone">Phone / WhatsApp</option><option value="email">Email</option></select><span id="contact-method-error" class="field-error" hidden></span></label>
        <label for="contact-value"><span id="contact-label">Your phone or email</span> <span class="fine">Required</span><input id="contact-value" name="contact-value" required maxlength="150" aria-describedby="contact-value-error" /><span id="contact-value-error" class="field-error" hidden></span></label>
        <label class="full" for="language">Preferred language <span class="fine">Optional</span><select id="language" name="language" aria-describedby="language-help"><option value="">No preference supplied</option><option>English</option><option>Tamil</option><option>Another language — discuss with Porul</option></select><span id="language-help" class="fine">This records your preference; support arrangements are confirmed when we discuss the work.</span></label>
        <div id="benefits-fields" class="full enquiry-fields" hidden>
          <label for="district">District / town <span class="fine">Required</span><input id="district" name="district" maxlength="100" disabled aria-describedby="district-error" /><span id="district-error" class="field-error" hidden></span></label>
          <label for="state">State <span class="fine">Required</span><select id="state" name="state" disabled aria-describedby="state-error"><option value="">Select a state</option><option>Tamil Nadu</option><option>Karnataka</option><option>Another state — scope review needed</option></select><span id="state-error" class="field-error" hidden></span></label>
          <label class="full" for="stage">Business stage <span class="fine">Required</span><select id="stage" name="stage" disabled aria-describedby="stage-error"><option value="">Select your stage</option><option value="planning">Planning a manufacturing unit</option><option value="producing">Production has started</option><option value="expanding">Expanding an existing unit</option></select><span id="stage-error" class="field-error" hidden></span></label>
          <label for="udyam">Udyam registration <span class="fine">Optional</span><select id="udyam" name="udyam" disabled><option value="">Not supplied</option><option>Done</option><option>Not done</option><option>Not sure</option></select></label>
          <label id="production-field" for="production" hidden>Production start month <span class="fine">Optional</span><input id="production" type="month" name="production" disabled /></label>
          <label class="full" id="machinery-field" for="machinery" hidden>Machinery stage <span class="fine">Optional</span><select id="machinery" name="machinery" disabled><option value="">Not supplied</option><option>Planning a purchase</option><option>Already purchased</option><option>Both existing and planned machinery</option><option>Not sure</option></select></label>
        </div>
        <label class="full" id="gem-status-field" for="status" hidden>Current GeM status <span class="fine">Required</span><select id="status" name="status" disabled aria-describedby="status-error"><option value="">Select your status</option><option>Not registered yet</option><option>Registration is incomplete</option><option>Registered, need catalogue help</option><option>Registered, need bid assistance</option><option>Not sure / not applicable</option></select><span id="status-error" class="field-error" hidden></span></label>
        <label class="full" for="details"><span id="details-label">Your requirement and any deadline</span> <span class="fine">Required</span><textarea id="details" name="details" rows="5" required maxlength="700" aria-describedby="details-help details-error"></textarea><span id="details-error" class="field-error" hidden></span></label>
      </div>
      <p id="details-help" class="fine">For a tender, include the official link or ID and closing date. Do not include passwords, OTPs, DSC PINs, identity or bank documents, or financial amounts.</p>
      <p class="fine">Nothing is sent automatically or saved in browser storage. Preparing the draft keeps your details on this page. Opening a draft passes the message to WhatsApp or your email app. Read our <a href="/privacy/">enquiry privacy notice</a>.</p>
      <button class="button" type="submit">Prepare enquiry</button>
    </form>
    <noscript><div class="panel stack"><h2>Write to us directly</h2><p>Email <a href="mailto:hello@porul.in">hello@porul.in</a> or use the WhatsApp link above. Include your name, a contact method, the help you need, and your requirement. Business name and preferred language are optional.</p><p>For government schemes, include your district, state and business stage. For GeM, include your current portal status; for a bid, include its official link and deadline. Do not send passwords or identity and bank documents.</p></div></noscript>
    <section id="enquiry-result" class="panel stack" hidden aria-labelledby="draft-title">
      <h2 id="draft-title" tabindex="-1">Your message is ready to review.</h2><p><strong>Not sent yet.</strong> Open WhatsApp or your email app, review the message and send it. Preparing or copying it does not contact Porul.</p>
      <label for="enquiry-message">Your enquiry</label><textarea id="enquiry-message" rows="12" readonly></textarea>
      <div class="draft-actions"><a id="open-whatsapp" class="button">Open WhatsApp draft</a><a id="open-email" class="button button--ghost">Open email draft</a><button id="copy-enquiry" type="button" class="button button--ghost" disabled>Copy enquiry</button></div>
      <p id="copy-status" role="status" class="fine"></p><p class="fine">No email app? Copy the message into your webmail and send it to <a href="mailto:hello@porul.in">hello@porul.in</a>. Any edit to the form requires a fresh draft.</p>
    </section>
    <aside class="next-steps stack"><h2>What happens next</h2><p>Once your message reaches us, Porul reviews the requirement and confirms scope and any fee. Preparing an enquiry does not book a service or create a payment obligation. No payment is collected here.</p><p>GeM registration, catalogue and DSC support are handled by Porul’s MSME and GeM portal specialist. Website, software and other requirements need a capability and scope review. A story enquiry does not guarantee acceptance or publication.</p><p>For an agreed scheme check in Tamil Nadu or Karnataka, you receive a written shortlist, a checklist and an explanatory call. Authorities decide eligibility and approval. Application filing, department follow-ups, appeals and arranging loans are outside this service.</p><div class="draft-actions"><a class="text-link" href="/gem-services/">GeM scope and FAQs</a><a class="text-link" href="/msme-benefits/">Government scheme scope and FAQs</a></div></aside>
  </div></section>
</BaseLayout>
<script>
  import { whatsappUrl } from "@/data/contact";
  import { benefitsLines, fieldState } from "@/lib/enquiry.mjs";
  const form = document.querySelector<HTMLFormElement>("#enquiry-form");
  const result = document.querySelector<HTMLElement>("#enquiry-result");
  const message = document.querySelector<HTMLTextAreaElement>("#enquiry-message");
  const emailLink = document.querySelector<HTMLAnchorElement>("#open-email");
  const whatsappLink = document.querySelector<HTMLAnchorElement>("#open-whatsapp");
  const copyButton = document.querySelector<HTMLButtonElement>("#copy-enquiry");
  const copyStatus = document.querySelector<HTMLElement>("#copy-status");
  const summary = document.querySelector<HTMLElement>("#enquiry-errors");
  const errorList = document.querySelector<HTMLUListElement>("#error-list");
  if (form && result && message && emailLink && whatsappLink && copyButton && summary && errorList) {
    type Field = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
    const field = (name: string) => form.elements.namedItem(name) as Field;
    const service = field("service") as HTMLSelectElement;
    const method = field("contact-method") as HTMLSelectElement;
    const contact = field("contact-value") as HTMLInputElement;
    const selected = new URLSearchParams(location.search).get("service");
    if (selected && Array.from(service.options).some(option => option.value === selected)) service.value = selected;
    let attempted = false;
    let draftVersion = 0;
    const invalidateDraft = () => {
      draftVersion += 1;
      result.hidden = true; message.value = "";
      emailLink.removeAttribute("href"); whatsappLink.removeAttribute("href");
      copyButton.disabled = true;
      if (copyStatus) copyStatus.textContent = "";
    };
    const syncFields = () => {
      const needsStatus = ["gem", "registration", "catalogue", "dsc", "bid"].includes(service.value);
      field("status").disabled = !needsStatus; field("status").required = needsStatus;
      const statusWrapper = document.querySelector<HTMLElement>("#gem-status-field");
      if (statusWrapper) statusWrapper.hidden = !needsStatus;
      const fields = fieldState(service.value, field("stage").value);
      const benefits = document.querySelector<HTMLElement>("#benefits-fields");
      if (benefits) benefits.hidden = !fields.benefits;
      benefits?.querySelectorAll<Field>("input, select").forEach(input => {
        input.disabled = !fields.benefits;
        input.required = fields.benefits && ["district", "state", "stage"].includes(input.name);
      });
      for (const key of ["production", "machinery"] as const) {
        field(key).disabled = !fields[key];
        const wrapper = document.querySelector<HTMLElement>(`#${key}-field`);
        if (wrapper) wrapper.hidden = !fields[key];
      }
      const label = document.querySelector("#details-label");
      if (label) label.textContent = fields.benefits ? "What do you manufacture, and what would you like to understand?"
        : service.value === "dsc" ? "Intended use, preferred validity, delivery city and any deadline"
        : service.value === "story" ? "Your story idea or commissioned-piece requirement"
        : service.value === "website-software" ? "What does your website or software need to do?" : "Your requirement and any deadline";
      contact.type = method.value === "email" ? "email" : method.value === "phone" ? "tel" : "text";
      contact.autocomplete = method.value === "email" ? "email" : method.value === "phone" ? "tel" : "off";
      const contactLabel = document.querySelector("#contact-label");
      if (contactLabel) contactLabel.textContent = method.value === "email" ? "Your email address" : method.value === "phone" ? "Your phone / WhatsApp number" : "Your phone or email";
    };
    const fieldNames: Record<string, string> = { service: "Requirement type", name: "Your name", "contact-method": "Contact method", "contact-value": "Phone or email", district: "District / town", state: "State", stage: "Business stage", status: "GeM status", details: "Your requirement" };
    const validate = () => {
      errorList.replaceChildren();
      for (const [name, label] of Object.entries(fieldNames)) {
        const input = field(name);
        input.setCustomValidity("");
        let error = "";
        if (!input.disabled && input.required && !input.value.trim()) error = `Enter ${label.toLowerCase()}.`;
        else if (!input.disabled && !input.validity.valid) error = name === "contact-value" && method.value === "email" ? "Enter a valid email address." : `Check ${label.toLowerCase()}.`;
        input.setCustomValidity(error);
        const inline = document.getElementById(`${input.id}-error`);
        if (inline) { inline.textContent = error; inline.hidden = !error; }
        if (error) {
          input.setAttribute("aria-invalid", "true");
          const item = document.createElement("li"); const link = document.createElement("a");
          link.href = `#${input.id}`; link.textContent = error; item.append(link); errorList.append(item);
        } else input.removeAttribute("aria-invalid");
      }
      summary.hidden = !errorList.children.length;
      return summary.hidden;
    };
    syncFields();
    const onEdit = () => { invalidateDraft(); syncFields(); if (attempted) validate(); };
    form.addEventListener("input", onEdit); form.addEventListener("change", onEdit);
    form.addEventListener("submit", event => {
      event.preventDefault(); attempted = true;
      if (!validate()) { invalidateDraft(); summary.focus(); return; }
      const values = new FormData(form);
      const read = (name: string) => String(values.get(name) ?? "").trim();
      const label = service.selectedOptions[0].textContent ?? "Requirement";
      const subject = `Porul enquiry: ${label}`;
      const body = ["Hello Porul,", "", `Name: ${read("name")}`, ...(read("business") ? [`Business: ${read("business")}`] : []), `${method.value === "email" ? "Email" : "Phone / WhatsApp"}: ${read("contact-value")}`, `Requirement type: ${label}`, ...(read("language") ? [`Preferred language: ${read("language")}`] : []), ...benefitsLines(Object.fromEntries(values)), ...(field("status").disabled ? [] : [`GeM status: ${read("status")}`]), "", "Requirement:", read("details"), "", "Please review my requirement and confirm scope and any fee before work begins."].join("\n");
      message.value = body;
      emailLink.href = `mailto:hello@porul.in?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      whatsappLink.href = whatsappUrl(body);
      copyButton.disabled = false; result.hidden = false;
      if (copyStatus) copyStatus.textContent = "";
      document.querySelector<HTMLElement>("#draft-title")?.focus();
    });
    copyButton.addEventListener("click", async () => {
      if (result.hidden || !message.value) return;
      const version = draftVersion;
      try {
        await navigator.clipboard.writeText(message.value);
        if (version === draftVersion && copyStatus) copyStatus.textContent = "Copied. Paste into WhatsApp or email, review and send to Porul.";
      } catch {
        if (version !== draftVersion) return;
        message.focus(); message.select();
        if (copyStatus) copyStatus.textContent = "Automatic copying is unavailable. The message is selected so you can copy it manually.";
      }
    });
    form.hidden = false;
  }
</script>
<style>
  .enquiry-fields { display: grid; grid-template-columns: var(--grid-pair); gap: var(--grid-gap); }
  .full { grid-column: 1 / -1; }
  label { display: flex; flex-direction: column; gap: var(--label-gap); font-size: var(--type-control); font-weight: var(--weight-semibold); line-height: var(--leading-control); min-width: var(--width-zero); }
  label .fine { font-weight: var(--weight-regular); }
  input, select, textarea { width: var(--width-full); min-width: var(--width-zero); min-height: var(--control-height); padding: var(--control-padding-y) var(--control-padding-x); border: var(--border-width) solid var(--control-border); border-radius: var(--radius-control); background: var(--control-surface); color: var(--control-text); font-family: var(--font-ui); font-size: var(--type-control); font-weight: var(--weight-regular); line-height: var(--leading-control); }
  textarea { resize: vertical; }
  input:hover, select:hover, textarea:hover { border-color: var(--control-border-hover); }
  [aria-invalid="true"] { border-color: var(--error); border-width: var(--border-width-active); }
  .field-error { color: var(--error); font-size: var(--type-meta); font-weight: var(--weight-regular); line-height: var(--leading-meta); }
  .error-summary { margin-bottom: var(--group-gap); padding: var(--panel-padding); border: var(--border-width-active) solid var(--error); border-radius: var(--radius-panel); }
  .error-summary h2 { font-size: var(--type-card); line-height: var(--leading-card); }
  .error-summary ul { margin-bottom: var(--space-0); }
  .draft-actions { display: flex; flex-wrap: wrap; gap: var(--item-gap); align-items: center; }
  .draft-actions > * { max-width: var(--width-full); }
  .next-steps { padding-top: var(--group-gap); border-top: var(--border-width) solid var(--border); }
</style>
