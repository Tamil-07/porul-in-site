---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { dscFaqs, dscService } from "@/data/dsc";
import { whatsappDisplay, whatsappUrl } from "@/data/contact";
import "@/styles/services.css";

const whatsappMessage = "Hello Porul, I need a Class 3 DSC. Purpose: GeM / GST / MCA. Preferred validity: 2 years / 3 years. Delivery city: ";
const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "GeM services", path: "/gem-services/" },
  { name: "Digital signature for GeM", path: dscService.path }
];
---
<BaseLayout
  layout="catalog"
  title="Class 3 DSC for GeM Bidding with USB Token"
  description="Get a Class 3 signing and encryption DSC with a HYP2003 or Precision USB token. Two or three years, with delivery across South India."
  service={dscService}
  faqs={dscFaqs}
  breadcrumbs={breadcrumbs}
>
  <div class="service-page">
    <header class="service-intro"><div class="wrap">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/gem-services/">GeM services</a><span aria-hidden="true">/</span><span>Digital signature</span></nav>
      <div class="dsc-hero">
        <div>
          <p class="eyebrow">Class 3 DSC / South India</p>
          <h1>Class 3 Digital Signature Certificate with USB token.</h1>
          <p class="intro-copy">For GeM bidding, GST and MCA filings. Choose two-year or three-year validity. Porul coordinates the application, KYC, certificate issuance, token delivery and setup guidance.</p>
          <div class="actions"><a class="button" href={whatsappUrl(whatsappMessage)}>WhatsApp {whatsappDisplay} →</a><a href="/enquire/?service=dsc">Prepare an enquiry</a></div>
          <p class="fine">Price is shared after we confirm the applicant, validity and delivery city.</p>
        </div>
        <aside class="dsc-product-card" aria-label="Class 3 DSC package">
          <h2 class="dsc-package-title">Your DSC package</h2>
          <dl class="dsc-specs">
            <div><dt>Certificate</dt><dd>Class 3 signing + encryption</dd></div>
            <div><dt>Validity</dt><dd>2 years or 3 years</dd></div>
            <div><dt>USB token</dt><dd>HYP2003 or Precision</dd></div>
            <div><dt>Delivery</dt><dd>Across South India</dd></div>
          </dl>
          <p class="fine">Porul.in is an independent service provider and is not affiliated with GeM or the Government of India.</p>
        </aside>
      </div>
    </div></header>

    <section class="service-band" aria-labelledby="included-title"><div class="wrap">
      <p class="eyebrow">What you receive</p>
      <h2 id="included-title">The certificate, the token and help using both.</h2>
      <div class="service-grid service-grid--four dsc-includes">
        <article><p class="dsc-card-number" aria-hidden="true">01</p><h3>Class 3 DSC</h3><p>A signing and encryption certificate with a choice of two-year or three-year validity.</p></article>
        <article><p class="dsc-card-number" aria-hidden="true">02</p><h3>USB token</h3><p>A HYP2003 or Precision token is included and delivered to the confirmed address.</p></article>
        <article><p class="dsc-card-number" aria-hidden="true">03</p><h3>Setup tutorial</h3><p>A tutorial video explains how to connect the token and use the certificate.</p></article>
        <article><p class="dsc-card-number" aria-hidden="true">04</p><h3>Renewal reminder</h3><p>Porul records the validity period and sends a reminder before renewal is due.</p></article>
      </div>
    </div></section>

    <section class="service-band" id="process" aria-labelledby="process-title"><div class="wrap service-split">
      <div>
        <p class="eyebrow">How it works</p>
        <h2 id="process-title">Start with one WhatsApp message.</h2>
        <p>Tell us where you will use the DSC, which validity you prefer and where the token must be delivered. You do not need to send identity documents in the first message.</p>
        <p><a href={whatsappUrl(whatsappMessage)}>Start the DSC enquiry on WhatsApp →</a></p>
      </div>
      <ol class="service-steps dsc-process">
        <li><strong>Porul calls you back.</strong><span> We confirm the applicant, intended use, validity choice and delivery city.</span></li>
        <li><strong>KYC is completed.</strong><span> We guide the applicant through the required verification process.</span></li>
        <li><strong>The certificate is issued.</strong><span> The approved DSC and its USB token are prepared and dispatched.</span></li>
        <li><strong>You receive setup help.</strong><span> We share the tutorial and can help with GeM registration or portal use when agreed.</span></li>
      </ol>
    </div></section>

    <section class="service-band" aria-labelledby="uses-title"><div class="wrap">
      <p class="eyebrow">Common uses</p>
      <h2 id="uses-title">One certificate for the business filings that ask for it.</h2>
      <div class="service-grid">
        <article><h3>GeM bids</h3><p>For an authorised signatory when a GeM bid or submission step asks for certificate-based signing.</p><p><a href="/guides/is-dsc-mandatory-for-gem/">Check whether your GeM task needs a DSC →</a></p></article>
        <article><h3>GST filings</h3><p>For GST portal actions where the business type or filing workflow requires a Digital Signature Certificate.</p></article>
        <article><h3>MCA filings</h3><p>For company and LLP filings that require the relevant director, professional or authorised signatory to sign digitally.</p></article>
      </div>
      <p class="fine">The portal or filing instruction decides who must sign and which signing route applies. Confirm the intended use before the application begins.</p>
    </div></section>

    <section class="service-band dsc-trust-band" aria-labelledby="team-title"><div class="wrap service-split">
      <div>
        <p class="eyebrow">Handled by a person who knows the workflow</p>
        <h2 id="team-title">MSME and GeM experience behind the application.</h2>
        <p>Your request is handled by Porul's MSME and GeM portal specialist, who has five years of experience working with MSMEs. The specialist coordinates the application and remains available for the agreed GeM support after delivery.</p>
        <p class="fine">The specialist's name is shared directly with the applicant during service delivery.</p>
      </div>
      <div class="dsc-evidence-card">
        <h3>Issuing route</h3>
        <p>Porul provides this service through <strong>Finbees Consulting</strong>, a partner of <strong>eMudhra, PantaSign and Capricorn</strong>.</p>
        <p>The certifying authority used for your order is confirmed during the application process. Certificate issuance follows that authority's KYC and approval process.</p>
      </div>
    </div></section>

    <section class="service-band" aria-labelledby="coverage-title"><div class="wrap service-split">
      <div><p class="eyebrow">Service area</p><h2 id="coverage-title">Delivery across South India.</h2><p>Porul can arrange DSC and USB-token delivery across South India, including Coimbatore, Chennai and Hosur. These are delivery locations, not Porul office locations.</p></div>
      <div><h2>Already have a DSC?</h2><p>Before ordering another certificate, check the holder name, certificate type, expiry date and the instruction shown by the portal. Never share the token PIN. Porul can help you identify what still needs to be checked.</p></div>
    </div></section>

    <section class="service-band" aria-labelledby="faq-title"><div class="wrap dsc-reading-wrap">
      <p class="eyebrow">Before you apply</p>
      <h2 id="faq-title">Questions customers ask us</h2>
      {dscFaqs.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}
    </div></section>

    <section class="service-band" aria-labelledby="sources-title"><div class="wrap dsc-reading-wrap">
      <h2 id="sources-title">Official references</h2>
      <p>This page combines Porul's current service scope with public guidance from the portals and the Controller of Certifying Authorities.</p>
      <ul>
        <li><a href="https://assets-bg.gem.gov.in/resources/upload/shared_doc/training_content/E-Sign-DSC-Process-1685708713.pdf">GeM eSign and DSC process workflow</a></li>
        <li><a href="https://gem.gov.in/userFaqs/seller">GeM seller FAQs</a></li>
        <li><a href="https://cca.gov.in/digital_signature.html">Controller of Certifying Authorities: how to obtain a DSC</a></li>
      </ul>
      <p class="fine">Service facts reviewed <time datetime="2026-09-30">30 September 2026</time>. Current portal instructions and the specific bid or filing govern the signing requirement.</p>
    </div></section>

    <section class="service-band dsc-final-cta" aria-labelledby="contact-title"><div class="wrap service-split">
      <div><p class="eyebrow">Ready to apply?</p><h2 id="contact-title">Tell us the use, validity and delivery city.</h2><p>Porul will call back, confirm the applicant and explain the next KYC step.</p></div>
      <div class="actions"><a class="button" href={whatsappUrl(whatsappMessage)}>Message Porul on WhatsApp →</a><a href="mailto:hello@porul.in?subject=Class%203%20DSC%20enquiry">hello@porul.in</a></div>
    </div></section>
  </div>
</BaseLayout>
