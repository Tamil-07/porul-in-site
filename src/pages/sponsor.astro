---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Prose from "@/components/Prose.astro";
---

<BaseLayout title="Sponsor — Porul.in" description="Quiet, factual sponsorship information for Porul.in.">
  <section class="page-intro">
    <div class="wrap">
      <p class="page-intro__kicker">Sponsorship</p>
      <h1>Editorial sponsorship, sold directly.</h1>
      <p class="page-intro__dek">Porul.in accepts only clear, disclosed sponsorship that fits the publication. There is no display-ad infrastructure, no ad server, and no programmatic slot.</p>
    </div>
  </section>

  <section class="page-band">
    <div class="wrap page-grid">
      <Prose>
        <h2>What Can Be Sponsored</h2>
        <p>A company story, an expo promotion, or a product launch feature can be sponsored when the disclosure is visible and the subject fits Porul.in's editorial boundaries.</p>
        <h2>What Cannot Be Sponsored</h2>
        <p>Editorial opinion, sourcing, matching, fulfilment, buyer access, or hidden influence cannot be bought. Sponsorship buys attention and craft, not a breach of trust.</p>
        <h2>Disclosure</h2>
        <p>Sponsored entries render a visible "Sponsored profile" pill on cards and article pages. That disclosure is non-negotiable.</p>
      </Prose>
      <aside class="panel cham">
        <h2>Contact Path</h2>
        <p>Prices are not listed here because prices move. The founder will handle sponsorship conversations directly.</p>
        <p><a href="mailto:hello@porul.in">hello@porul.in</a></p>
      </aside>
    </div>
  </section>
</BaseLayout>
